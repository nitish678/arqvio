//--- family MA_CROSS (backtest/strategies/ma_crossover.py) ---------
const int MA_FAST = {{ cfg.fast }};
const int MA_SLOW = {{ cfg.slow }};
const int P_ATR_PERIOD = {{ cfg.atr_period }};
double P_VOLUME, P_SL_ATR, P_TP_ATR;

void FamilyInitConstants()
  {
   P_VOLUME = FromBits({{ cfg.volume | bits }});
   P_SL_ATR = FromBits({{ cfg.sl_atr | bits }});
   P_TP_ATR = FromBits({{ cfg.tp_atr | bits }});
  }

void FamilyUpdate(const int i) { }   // SMAs are read from the close series on demand

// Level B row: fast/slow SMA now and prev, then the bullish and bearish cross conditions (state-free).
string FamilyDump(const int i)
  {
   if(i < MA_SLOW) return ",,,,,";
   double fn = PwMean(g_close, i - MA_FAST + 1, MA_FAST), sn = PwMean(g_close, i - MA_SLOW + 1, MA_SLOW);
   double fp = PwMean(g_close, i - MA_FAST, MA_FAST), sp = PwMean(g_close, i - MA_SLOW, MA_SLOW);
   return HB(fn) + "," + HB(sn) + "," + HB(fp) + "," + HB(sp) + "," + B01(fp <= sp && fn > sn) + ","
          + B01(fp >= sp && fn < sn);
  }

// The entry / pending-open intent, after the ATR stop distances; false when ATR suppresses it.
bool MaOpen(const int dir, const int i, const string reason, Intent &out)
  {
   bool suppress, hs, ht;
   double sd, td;
   StopDistances(i, P_SL_ATR, P_TP_ATR, P_ATR_PERIOD, suppress, hs, sd, ht, td);
   if(suppress) return false;
   out = MakeIntent(dir, P_VOLUME, i, reason, hs, sd, ht, td);
   return true;
  }

bool FamilyOnBar(const int i, Intent &out)
  {
   if(i < MA_SLOW) return false;   // warmup = slow
   if(g_pending_dir != 0)
     {
      // distances BEFORE the state mutation: a suppressed bar leaves the state as it was
      if(!MaOpen(g_pending_dir, i, "PENDING_OPEN", out)) return false;
      g_dir = g_pending_dir;
      g_pending_dir = 0;
      return true;
     }
   double fast_now = PwMean(g_close, i - MA_FAST + 1, MA_FAST);
   double slow_now = PwMean(g_close, i - MA_SLOW + 1, MA_SLOW);
   double fast_prev = PwMean(g_close, i - MA_FAST, MA_FAST);
   double slow_prev = PwMean(g_close, i - MA_SLOW, MA_SLOW);
   bool cl = g_dir > 0, cs = g_dir < 0;
   if(fast_prev <= slow_prev && fast_now > slow_now)
     {
      if(cs)
        {
         g_dir = 0; g_pending_dir = 1;
         out = MakeIntent(1, 0.0, i, "REVERSAL_CLOSE", false, 0.0, false, 0.0);
         return true;
        }
      if(!cl)
        {
         if(!MaOpen(1, i, "ENTRY", out)) return false;
         g_dir = 1;
         return true;
        }
     }
   if(fast_prev >= slow_prev && fast_now < slow_now)
     {
      if(cl)
        {
         g_dir = 0; g_pending_dir = -1;
         out = MakeIntent(-1, 0.0, i, "REVERSAL_CLOSE", false, 0.0, false, 0.0);
         return true;
        }
      if(!cs)
        {
         if(!MaOpen(-1, i, "ENTRY", out)) return false;
         g_dir = -1;
         return true;
        }
     }
   return false;
  }
