//+------------------------------------------------------------------+
//| {{ name }}.mq5
//| Generated by ARQVIO {{ template_version }} -- do not edit.
//| G9 ATR verifier (S6 PART 5): the codegen's ported ATR({{ period }}) -- the SAME atr_core the EAs are
//| generated with -- and MT5's native iATR({{ period }}) on the terminal's own {{ symbol }} H1 bars,
//| {{ from_time }}..{{ to_time }} ({{ n }} bars), dumped as exact bit patterns. Reads bars only; no trading.
//+------------------------------------------------------------------+
#property strict
#property script_show_inputs

const string SYMBOL = "{{ symbol }}";
const long FROM_TIME = {{ from_time }};
const long TO_TIME = {{ to_time }};
const int N = {{ n }};
const int PERIOD = {{ period }};

double g_high[], g_low[], g_close[];
double g_tr[], g_csum[];

{% include "atr_core.j2" %}

union UBits { ulong u; double d; };
// The bit pattern as a decimal integer: every value dumped is >= 0, so the sign bit is 0 and the
// pattern fits a long (no unsigned formatting needed).
string U(const double d) { UBits b; b.d = d; return IntegerToString((long)b.u); }

void Fail(const string why)
  {
   Print("ARQVIO ATR verifier FAILED: ", why);
   int h = FileOpen("{{ out_file }}.failed", FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_ANSI);
   if(h != INVALID_HANDLE) { FileWriteString(h, why + "\n"); FileClose(h); }
  }

void OnStart()
  {
   MqlRates r[];
   int got = CopyRates(SYMBOL, PERIOD_H1, (datetime)FROM_TIME, (datetime)TO_TIME, r);
   if(got != N) { Fail(StringFormat("CopyRates returned %d bars, expected %d", got, N)); return; }
   if((long)r[0].time != FROM_TIME || (long)r[N - 1].time != TO_TIME) { Fail("window endpoints differ"); return; }
   ArrayResize(g_high, N); ArrayResize(g_low, N); ArrayResize(g_close, N);
   for(int i = 0; i < N; i++) { g_high[i] = r[i].high; g_low[i] = r[i].low; g_close[i] = r[i].close; }
   int handle = iATR(SYMBOL, PERIOD_H1, PERIOD);
   if(handle == INVALID_HANDLE) { Fail("iATR handle"); return; }
   for(int k = 0; k < 300 && BarsCalculated(handle) <= 0; k++) Sleep(100);
   double native[];
   ArraySetAsSeries(native, false);
   int nb = CopyBuffer(handle, 0, (datetime)FROM_TIME, (datetime)TO_TIME, native);
   if(nb != N) { Fail(StringFormat("CopyBuffer returned %d values, expected %d", nb, N)); return; }
   int h = FileOpen("{{ out_file }}", FILE_WRITE | FILE_CSV | FILE_COMMON | FILE_ANSI, ',');
   if(h == INVALID_HANDLE) { Fail("cannot open the dump file"); return; }
   for(int i = 0; i < N; i++)
     {
      UpdateTR(i);
      double atr = 0.0;
      bool ok = AtrAt(i, PERIOD, atr);
      FileWrite(h, (long)r[i].time, U(r[i].open), U(r[i].high), U(r[i].low), U(r[i].close), U(g_tr[i]),
                U(g_csum[i]), ok ? U(atr) : "", U(native[i]), "x");
     }
   FileClose(h);
   Print("ARQVIO ATR verifier wrote ", N, " rows");
  }
//+------------------------------------------------------------------+
