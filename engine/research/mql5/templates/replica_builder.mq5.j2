//+------------------------------------------------------------------+
//| replica_builder_{{ cell_name }}.mq5
//| Generated by ARQVIO {{ template_version }} -- do not edit.
//| Builds the S6 tester replica symbols {{ sym_l }} (low-first path) and {{ sym_h }} (high-first path)
//| from Common\Files\ARQVIO_S6\cells\{{ cell_name }}\m1_{L,H}.csv: digits {{ digits }} (cell + 3),
//| bar spread 1 replica point, swap / commission / stop levels 0, sessions 24x7, contract size 1 (CFD
//| margin = lots x contract x price; tester-native PnL is not used by the parity levels). Tester plumbing
//| only: no broker symbol is touched.
//+------------------------------------------------------------------+
#property script_show_inputs
#property strict

const string CELL = "{{ cell_name }}";
const string NAMES[2] = {"{{ sym_l }}", "{{ sym_h }}"};
const string FILES[2] = {"m1_L.csv", "m1_H.csv"};
const int DIGITS = {{ digits }};

string g_report = "";

bool SetI(const string s, ENUM_SYMBOL_INFO_INTEGER p, long v)
  {
   if(CustomSymbolSetInteger(s, p, v)) return true;
   g_report += StringFormat("FAIL set %s err %d\n", EnumToString(p), GetLastError());
   return false;
  }
bool SetD(const string s, ENUM_SYMBOL_INFO_DOUBLE p, double v)
  {
   if(CustomSymbolSetDouble(s, p, v)) return true;
   g_report += StringFormat("FAIL set %s err %d\n", EnumToString(p), GetLastError());
   return false;
  }
bool SetS(const string s, ENUM_SYMBOL_INFO_STRING p, string v)
  {
   if(CustomSymbolSetString(s, p, v)) return true;
   g_report += StringFormat("FAIL set %s err %d\n", EnumToString(p), GetLastError());
   return false;
  }

int LoadRates(const string file, MqlRates &rates[])
  {
   int h = FileOpen(file, FILE_READ | FILE_CSV | FILE_COMMON | FILE_ANSI, ',');
   if(h == INVALID_HANDLE) return -1;
   int n = 0;
   while(!FileIsEnding(h))
     {
      string ts = FileReadString(h);
      if(ts == "") break;
      ArrayResize(rates, n + 1, 1 << 20);
      rates[n].time = (datetime)StringToInteger(ts);
      double p = StringToDouble(FileReadString(h));
      rates[n].open = p; rates[n].high = p; rates[n].low = p; rates[n].close = p;
      rates[n].spread = (int)StringToInteger(FileReadString(h));
      rates[n].tick_volume = 1;
      rates[n].real_volume = 0;
      n++;
     }
   FileClose(h);
   return n;
  }

bool Build(const int k)
  {
   string s = NAMES[k];
   bool custom = false;
   if(SymbolExist(s, custom))
     {
      if(!custom) { g_report += "FAIL " + s + " exists and is not a custom symbol\n"; return false; }
      SymbolSelect(s, false);
      if(!CustomSymbolDelete(s)) { g_report += StringFormat("FAIL delete %s err %d\n", s, GetLastError()); return false; }
     }
   if(!CustomSymbolCreate(s, "ARQVIO_S6\\" + CELL, NULL)) { g_report += StringFormat("FAIL create %s err %d\n", s, GetLastError()); return false; }
   double pt = MathPow(10.0, -DIGITS);
   bool ok = SetI(s, SYMBOL_DIGITS, DIGITS) && SetD(s, SYMBOL_POINT, pt) && SetD(s, SYMBOL_TRADE_TICK_SIZE, pt)
             && SetD(s, SYMBOL_TRADE_TICK_VALUE, 1.0) && SetD(s, SYMBOL_TRADE_CONTRACT_SIZE, 1.0)
             && SetI(s, SYMBOL_TRADE_CALC_MODE, SYMBOL_CALC_MODE_CFD)
             && SetS(s, SYMBOL_CURRENCY_BASE, "USD") && SetS(s, SYMBOL_CURRENCY_PROFIT, "USD")
             && SetS(s, SYMBOL_CURRENCY_MARGIN, "USD")
             && SetI(s, SYMBOL_SPREAD, 0) && SetI(s, SYMBOL_SPREAD_FLOAT, 1)
             && SetI(s, SYMBOL_TRADE_STOPS_LEVEL, 0) && SetI(s, SYMBOL_TRADE_FREEZE_LEVEL, 0)
             && SetI(s, SYMBOL_TRADE_MODE, SYMBOL_TRADE_MODE_FULL)
             && SetI(s, SYMBOL_TRADE_EXEMODE, SYMBOL_TRADE_EXECUTION_MARKET)
             && SetI(s, SYMBOL_FILLING_MODE, SYMBOL_FILLING_FOK | SYMBOL_FILLING_IOC)
             && SetD(s, SYMBOL_VOLUME_STEP, {{ vstep }}) && SetD(s, SYMBOL_VOLUME_MAX, {{ vmax }})
             && SetD(s, SYMBOL_VOLUME_MIN, {{ vmin }})
             && SetI(s, SYMBOL_SWAP_MODE, SYMBOL_SWAP_MODE_DISABLED)
             && SetD(s, SYMBOL_SWAP_LONG, 0.0) && SetD(s, SYMBOL_SWAP_SHORT, 0.0);
   if(!ok) return false;
   for(int d = 0; d < 7; d++)
      if(!CustomSymbolSetSessionQuote(s, (ENUM_DAY_OF_WEEK)d, 0, 0, 86400)
         || !CustomSymbolSetSessionTrade(s, (ENUM_DAY_OF_WEEK)d, 0, 0, 86400))
        { g_report += StringFormat("FAIL session %s day %d err %d\n", s, d, GetLastError()); return false; }
   MqlRates rates[];
   int n = LoadRates("ARQVIO_S6\\cells\\" + CELL + "\\" + FILES[k], rates);
   if(n <= 0) { g_report += StringFormat("FAIL csv %s n=%d err %d\n", FILES[k], n, GetLastError()); return false; }
   int w = CustomRatesReplace(s, rates[0].time, rates[n - 1].time + 60, rates);
   if(w != n) { g_report += StringFormat("FAIL rates %s wrote %d of %d err %d\n", s, w, n, GetLastError()); return false; }
   if(!SymbolSelect(s, true)) { g_report += "FAIL select " + s + "\n"; return false; }
   g_report += StringFormat("OK %s m1=%d first=%I64d last=%I64d digits=%d\n", s, n, (long)rates[0].time,
                            (long)rates[n - 1].time, (int)SymbolInfoInteger(s, SYMBOL_DIGITS));
   return true;
  }

void OnStart()
  {
   bool ok = Build(0) && Build(1);
   g_report += ok ? "BUILD OK\n" : "BUILD FAILED\n";
   int h = FileOpen("ARQVIO_S6\\cells\\" + CELL + "\\build_result.txt", FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_ANSI);
   if(h != INVALID_HANDLE) { FileWriteString(h, g_report); FileClose(h); }
   Print("ARQVIO replica builder: ", g_report);
  }
//+------------------------------------------------------------------+
