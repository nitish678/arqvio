//--- exact constants: IEEE-754 bit patterns, never decimal literals
union UBits { ulong u; double d; };
double FromBits(const ulong u) { UBits b; b.u = u; return b.d; }
ulong ToBits(const double d) { UBits b; b.d = d; return b.u; }

double C_POINT, C_TICK_SIZE, C_TVP, C_TVL, C_VMIN, C_VSTEP, C_VMAX, C_SWAP_LONG, C_SWAP_SHORT;
double C_INITIAL, C_COMMISSION, C_MAX_SPREAD, C_PPL, C_PU_PROFIT, C_PU_LOSS, C_RP, C_P10, G_MAX_DD, G_RET_THRESHOLD;
double C_HOURLY[24];
bool C_NO_TRADE[24];

void InitConstants()
  {
   C_POINT = FromBits({{ point | bits }});
   C_TICK_SIZE = FromBits({{ tick_size | bits }});
   C_TVP = FromBits({{ tvp | bits }});
   C_TVL = FromBits({{ tvl | bits }});
   C_VMIN = FromBits({{ vmin | bits }});
   C_VSTEP = FromBits({{ vstep | bits }});
   C_VMAX = FromBits({{ vmax | bits }});
   C_SWAP_LONG = FromBits({{ swap_long | bits }});
   C_SWAP_SHORT = FromBits({{ swap_short | bits }});
   C_INITIAL = FromBits({{ initial_equity | bits }});
   C_COMMISSION = FromBits({{ commission | bits }});
   C_MAX_SPREAD = FromBits({{ (max_spread if max_spread is not none else 0.0) | bits }});
   G_MAX_DD = FromBits({{ gates[1] | bits }});
   G_RET_THRESHOLD = FromBits({{ gates[2] | bits }});
{% for h in hourly %}
   C_HOURLY[{{ loop.index0 }}] = FromBits({{ h | bits }});
{% endfor %}
{% for nt in no_trade %}
   C_NO_TRADE[{{ loop.index0 }}] = {{ "true" if nt else "false" }};
{% endfor %}
   // engine.py: _per_unit_per_lot = max(tvp, tvl) / tick_size; per-leg profit / loss
   C_PPL = MathMax(C_TVP, C_TVL) / C_TICK_SIZE;
   C_PU_PROFIT = C_TVP / C_TICK_SIZE;
   C_PU_LOSS = C_TVL / C_TICK_SIZE;
   C_RP = MathPow(10.0, -(DIGITS + 3));   // one replica point (the replica carries 3 extra digits)
   C_P10 = 1;
   for(int q = 0; q < DIGITS; q++) C_P10 *= 10;   // 10^DIGITS, exact (integer literals: no decimal literal here)
   FamilyInitConstants();
  }

//--- numpy-order primitives ------------------------------------------
// numpy pairwise_sum (float64, contiguous): < 8 -> sequential from 0.0; <= 128 -> 8 accumulators;
// else split at n/2 rounded down to a multiple of 8 (pinned empirically, s6 numpy_mean_probe).
double PwSum(const double &a[], const int lo, const int n)
  {
   if(n < 8)
     {
      double res = 0.0;
      for(int i = 0; i < n; i++) res += a[lo + i];
      return res;
     }
   if(n <= 128)
     {
      double r[8];
      for(int j = 0; j < 8; j++) r[j] = a[lo + j];
      int i = 8;
      for(; i < n - (n % 8); i += 8)
         for(int j = 0; j < 8; j++) r[j] += a[lo + i + j];
      double res = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]));
      for(; i < n; i++) res += a[lo + i];
      return res;
     }
   int n2 = n / 2;
   n2 -= n2 % 8;
   return PwSum(a, lo, n2) + PwSum(a, lo + n2, n - n2);
  }

double PwMean(const double &a[], const int lo, const int n) { return PwSum(a, lo, n) / n; }

// Python round(x) to an integer: exact round-half-to-even.
double PyRoundInt(const double x)
  {
   double f = MathFloor(x);
   double d = x - f;
   if(d > 0.5) return f + 1.0;
   if(d < 0.5) return f;
   return (MathMod(f, 2.0) == 0.0) ? f : f + 1.0;
  }

// SymbolSpec.normalise_volume
double Normalise(const double volume)
  {
   double steps = PyRoundInt(volume / C_VSTEP);
   double v = steps * C_VSTEP;
   return MathMax(C_VMIN, MathMin(C_VMAX, v));
  }

// engine._quantize: Python round(price, digits), correctly rounded on the EXACT binary value, half to even. Python
// returns the double nearest n / 10^D for the n nearest x, so the question is where x lies against the tie
// (2n + 1) / (2 * 10^D) -- below, above, or ON it (a dyadic tie such as 37/64 at D = 5 is a double) -- decided
// exactly in integers below. (DoubleToString rounds a decimal representation instead: level B caught 33 of 300
// seeded near-tie prices on the wrong side; s6 quantize_mirror.py checks this algorithm against round().)
struct U128 { ulong hi; ulong lo; };

void U128MulSmall(U128 &a, const uint m)   // a *= m; callers stay far below 2^128
  {
   ulong p0 = (a.lo & 0xFFFFFFFF) * m;
   ulong p1 = (a.lo >> 32) * m + (p0 >> 32);
   ulong p2 = (a.hi & 0xFFFFFFFF) * m + (p1 >> 32);
   ulong p3 = (a.hi >> 32) * m + (p2 >> 32);
   a.lo = (p0 & 0xFFFFFFFF) | (p1 << 32);
   a.hi = (p2 & 0xFFFFFFFF) | (p3 << 32);
  }

bool U128Shl(U128 &a, const int s)   // a <<= s; false when a set bit would leave the 128 bits
  {
   if(s == 0) return true;
   if(s >= 128) return a.hi == 0 && a.lo == 0;
   if(s >= 64)
     {
      if(a.hi != 0 || (s > 64 && (a.lo >> (128 - s)) != 0)) return false;
      a.hi = a.lo << (s - 64);
      a.lo = 0;
      return true;
     }
   if((a.hi >> (64 - s)) != 0) return false;
   a.hi = (a.hi << s) | (a.lo >> (64 - s));
   a.lo = a.lo << s;
   return true;
  }

int U128Cmp(const U128 &a, const U128 &b)
  {
   if(a.hi != b.hi) return a.hi < b.hi ? -1 : 1;
   if(a.lo != b.lo) return a.lo < b.lo ? -1 : 1;
   return 0;
  }

// sign(x - (2n + 1) / (2 * 10^D)) exactly, for x > 0 and integer-valued n >= 0:
// x = m * 2^e, so the sign is that of  m * 5^D * 2^(e + D + 1) - (2n + 1).
int CmpTie(const double x, const double n)
  {
   ulong u = ToBits(x);
   int ex = (int)((u >> 52) & 0x7FF);
   ulong m = u & 0xFFFFFFFFFFFFF;
   int e = -1074;
   if(ex != 0) { m |= ((ulong)1 << 52); e = ex - 1075; }
   U128 a, b;
   a.hi = 0; a.lo = m;
   for(int q = 0; q < DIGITS; q++) U128MulSmall(a, 5);
   b.hi = 0; b.lo = (ulong)(2.0 * n + 1.0);
   int s = e + DIGITS + 1;
   if(s >= 0) { if(!U128Shl(a, s)) return 1; }   // a left the 128 bits: a > b
   else if(!U128Shl(b, -s)) return -1;           // b left the 128 bits: b > a
   return U128Cmp(a, b);
  }

double Quantize(const double price)
  {
   if(price < 0.0) return -Quantize(-price);   // Python's round is symmetric
   if(price == 0.0) return price;
   double n = MathRound(price * C_P10);        // an estimate, off by at most one next to a tie
   int c = CmpTie(price, n);
   if(c > 0) n += 1.0;                                                  // above tie(n): n + 1
   else if(c == 0) { if(MathMod(n, 2.0) != 0.0) n += 1.0; }             // ON tie(n): the even of n, n + 1
   else if(n > 0.0)
     {
      int c1 = CmpTie(price, n - 1.0);
      if(c1 < 0) n -= 1.0;                                              // below tie(n - 1): n - 1
      else if(c1 == 0 && MathMod(n, 2.0) != 0.0) n -= 1.0;              // ON tie(n - 1): the even of n - 1, n
     }
   return n / C_P10;                           // correctly rounded division: the double nearest n / 10^D
  }

string Hex(const ulong u)
  {
   string s = "";
   for(int k = 15; k >= 0; k--)
     {
      int nib = (int)((u >> (4 * k)) & 0xF);
      s += StringSubstr("0123456789ABCDEF", nib, 1);
     }
   return s;
  }
string HB(const double d) { return Hex(ToBits(d)); }
string B01(const bool b) { return b ? "1" : "0"; }

//--- bars (window only; the replica's flat prefix is never stored) ----
