double g_tr[], g_csum[];

void AppendLE(uchar &dst[], const ulong u)
  {
   int n = ArraySize(dst);
   ArrayResize(dst, n + 8, 1 << 20);
   for(int b = 0; b < 8; b++) dst[n + b] = (uchar)((u >> (8 * b)) & 0xFF);
  }

void AppendBar(uchar &dst[], const long t, const double o, const double h, const double l, const double c)
  {
   AppendLE(dst, (ulong)t); AppendLE(dst, ToBits(o)); AppendLE(dst, ToBits(h)); AppendLE(dst, ToBits(l));
   AppendLE(dst, ToBits(c));
  }

// A chart price must be its raw bar price within the encoding offset (2 replica points).
bool NearRaw(const double chart, const double raw) { return MathAbs(chart - raw) <= 2.5 * C_RP; }

