//--- the shadow ledger: engine.py, step by step ----------------------
struct Position
  {
   bool open;
   int dir;
   double volume;
   double entry_requested, entry_filled;
   double e_spread, e_slip, e_comm;
   double swap_charged;
   bool has_sl, has_tp;
   double sl, tp;
   int entry_signal_bar, entry_fill_bar;
   long entry_time;
   ulong ticket;          // the tester position realising it
   string symbol;
  };

Position g_pos;
double g_realised = 0.0;
long g_last_swap_day = -1;
bool g_deferred_exit = false;
int g_trades = 0, g_round_trips = 0;
int c_blocked_events = 0, c_deferred_fills = 0, c_sltp_deferred = 0, c_blocked_max_spread = 0;
double t_spread = 0.0, t_slip = 0.0, t_comm = 0.0, t_swap = 0.0;
double g_equity[];
bool g_gap_tp = false;      // this bar opened beyond TP: resolve at :03 unless SL hits first
bool g_halted = false;
string g_exit_reason_counts = "";
int g_divergences = 0;

int h_intents = INVALID_HANDLE, h_fills = INVALID_HANDLE, h_trades = INVALID_HANDLE;
int h_equity = INVALID_HANDLE, h_events = INVALID_HANDLE, h_ind = INVALID_HANDLE;

void Event(const string kind, const string detail)
  {
   if(kind == "EXEC_DIVERGENCE") g_divergences++;
   FileWrite(h_events, kind, g_i, (g_i >= 0 && g_i < ArraySize(g_time)) ? g_time[g_i] : 0, detail);
  }

double Gross(const double price_move)
  {
   double signed_move = (double)g_pos.dir * price_move;
   double per_unit = (signed_move >= 0.0) ? C_PU_PROFIT : C_PU_LOSS;
   return signed_move * per_unit * g_pos.volume;
  }

double EntryTotalCost() { return g_pos.e_spread + g_pos.e_slip + g_pos.e_comm; }

double Unrealised(const double price)
  {
   if(!g_pos.open) return 0.0;
   return Gross(price - g_pos.entry_filled) - EntryTotalCost() - g_pos.swap_charged;
  }

// One engine fill: _simulate_fill. Draws slippage for EVERY intent, as the engine does.
void SimulateFill(const Intent &x, const double bar_open, const long bar_time,
                  double &filled, double &volume, double &spread_charge, double &slip_ccy, double &comm_charge, double &slip_pts)
  {
   if(g_k >= ArraySize(g_draws)) { Event("FATAL", "slippage draw stream exhausted"); g_halted = true; return; }
   slip_pts = g_draws[g_k++];
   double slip_price = slip_pts * C_POINT;
   filled = (x.dir > 0) ? bar_open + slip_price : bar_open - slip_price;
   volume = (x.volume == 0.0) ? C_VMIN : Normalise(MathMax(x.volume, C_VMIN));
   int hour = (int)((bar_time / 3600) % 24);
   double one_way = 0.0;
   if(x.volume > 0.0)
     {
      double spread_price = C_HOURLY[hour] * C_POINT;
      one_way = spread_price * volume * C_PPL;
     }
   double comm_one = C_COMMISSION * Normalise(volume);
   double comm_round = 2.0 * comm_one;
   slip_ccy = slip_price * C_PPL * volume;
   spread_charge = (x.volume > 0.0) ? one_way : 0.0;
   comm_charge = (x.volume > 0.0) ? comm_round : 0.0;
   FileWrite(h_fills, g_k - 1, x.id, bar_time, x.dir, HB(x.volume), HB(volume), HB(bar_open), HB(filled),
             HB(spread_charge), HB(slip_ccy), HB(comm_charge), HB(slip_pts));
  }

void JournalTrade(const string reason, const int exit_bar, const long exit_time, const double exit_requested,
                  const double exit_filled, const double x_spread, const double x_slip, const double x_comm,
                  const double gross, const double net)
  {
   FileWrite(h_trades, g_trades, g_pos.dir, HB(g_pos.volume), g_pos.entry_signal_bar, g_pos.entry_fill_bar,
             g_pos.entry_time, HB(g_pos.entry_requested), HB(g_pos.entry_filled), HB(g_pos.e_spread),
             HB(g_pos.e_slip), HB(g_pos.e_comm), HB(g_pos.swap_charged),
             g_pos.has_sl ? HB(g_pos.sl) : "", g_pos.has_tp ? HB(g_pos.tp) : "",
             exit_bar, exit_time, HB(exit_requested), HB(exit_filled), HB(x_spread), HB(x_slip), HB(x_comm),
             HB(gross), HB(net), reason);
  }

void CountExit(const string reason)
  {
   g_exit_reason_counts += reason + ";";
  }

// Close the shadow position (engine _close_trade_pnl_split + bookkeeping).
void ShadowClose(const double exit_price, const string reason, const int exit_bar, const long exit_time,
                 const double exit_requested, const double x_spread, const double x_slip, const double x_comm)
  {
   double gross = Gross(exit_price - g_pos.entry_filled);
   double net = gross - EntryTotalCost() - g_pos.swap_charged;
   g_realised += net;
   g_round_trips++;
   CountExit(reason);
   JournalTrade(reason, exit_bar, exit_time, exit_requested, exit_price, x_spread, x_slip, x_comm, gross, net);
   t_swap += g_pos.swap_charged;   // engine: cost_swap = sum(t.swap_charged for t in trades), in trade order
   g_pos.open = false;
  }

void OpenPosition(const Intent &x, const double filled, const double volume, const double bar_open,
                  const double sp, const double sl_ccy, const double cm, const int fill_bar, const long bar_time)
  {
   g_pos.open = true;
   g_pos.dir = x.dir;
   g_pos.volume = volume;
   g_pos.entry_requested = bar_open;
   g_pos.entry_filled = filled;
   g_pos.e_spread = sp; g_pos.e_slip = sl_ccy; g_pos.e_comm = cm;
   g_pos.swap_charged = 0.0;
   g_pos.entry_signal_bar = x.bar_index;
   g_pos.entry_fill_bar = fill_bar;
   g_pos.entry_time = bar_time;
   g_pos.has_sl = x.has_sl && x.sl_dist > 0.0;
   g_pos.has_tp = x.has_tp && x.tp_dist > 0.0;
   g_pos.sl = 0.0; g_pos.tp = 0.0;
   if(g_pos.has_sl) g_pos.sl = Quantize(x.dir > 0 ? filled - x.sl_dist : filled + x.sl_dist);
   if(g_pos.has_tp) g_pos.tp = Quantize(x.dir > 0 ? filled + x.tp_dist : filled - x.tp_dist);
   g_trades++;
   t_spread += sp; t_slip += sl_ccy; t_comm += cm;
  }

// engine._fill_intents over the pending list, in order.
void FillIntents(const double bar_open, const long bar_time, const int bar_index)
  {
   for(int n = 0; n < g_npend && !g_halted; n++)
     {
      Intent x = g_pending[n];
      double filled, volume, sp, sl_ccy, cm, slip_pts;
      SimulateFill(x, bar_open, bar_time, filled, volume, sp, sl_ccy, cm, slip_pts);
      if(g_halted) return;
      if(x.volume == 0.0)
        {
         if(!g_pos.open) continue;
         ShadowClose(filled, "SIGNAL", x.bar_index, bar_time, bar_open, sp, sl_ccy, cm);
         TesterClose("SIGNAL", bar_open);
        }
      else
        {
         if(g_pos.open)
           {
            ShadowClose(filled, "SIGNAL", x.bar_index, bar_time, bar_open, sp, sl_ccy, cm);
            TesterClose("SIGNAL", bar_open);
           }
         OpenPosition(x, filled, volume, bar_open, sp, sl_ccy, cm, bar_index, bar_time);
         TesterOpen(bar_open);
        }
     }
  }

// engine._charge_swap: the nights between two day-rolls, triple on TRIPLE_DAY (Python weekday).
void ChargeSwap(const long from_day, const long to_day)
  {
   if(to_day <= from_day) return;
   double base = (g_pos.dir > 0) ? C_SWAP_LONG : C_SWAP_SHORT;
   double total_points = 0.0;
   for(long d = from_day + 1; d <= to_day; d++)
     {
      int weekday = (int)((3 + d) % 7);   // 1970-01-01 was a Thursday (Python weekday 3)
      int multiplier = (weekday == TRIPLE_DAY) ? 3 : 1;
      double points_for_day = base * multiplier;
      total_points += points_for_day;
     }
   double vol = Normalise(g_pos.volume);
   double account_charged = total_points * C_POINT * vol * C_PPL;
   g_pos.swap_charged += -account_charged;
  }

// engine._check_sl_tp: SL wins when both are inside the bar (pessimism).
string CheckSLTP(const double high, const double low)
  {
   if(!g_pos.has_sl && !g_pos.has_tp) return "";
   bool lng = g_pos.dir > 0;
   bool sl_hit = g_pos.has_sl && (lng ? low <= g_pos.sl : high >= g_pos.sl);
   bool tp_hit = g_pos.has_tp && (lng ? high >= g_pos.tp : low <= g_pos.tp);
   if(sl_hit) return "SL";
   if(tp_hit) return "TP";
   return "";
  }

// engine._exit_price_for: the level, unless the bar opened beyond it.
double ExitPriceFor(const string reason, const double bar_open)
  {
   double level = (reason == "SL") ? g_pos.sl : g_pos.tp;
   bool lng = g_pos.dir > 0;
   bool gapped;
   if(reason == "SL") gapped = lng ? bar_open < level : bar_open > level;
   else gapped = lng ? bar_open > level : bar_open < level;
   return gapped ? bar_open : level;
  }

//--- the tester realisation (replica execution) ----------------------
CTrade trade;

bool TesterPositionOpen()
  {
   return g_pos.ticket != 0 && PositionSelectByTicket(g_pos.ticket);
  }

void TesterOpen(const double bar_open)
  {
   string sym = (g_pos.dir > 0) ? SYM_L : SYM_H;
   trade.SetTypeFillingBySymbol(sym);
   bool ok = (g_pos.dir > 0) ? trade.Buy(g_pos.volume, sym, 0.0, 0.0, 0.0, "arqvio")
                             : trade.Sell(g_pos.volume, sym, 0.0, 0.0, 0.0, "arqvio");
   double px = trade.ResultPrice();
   g_pos.symbol = sym;
   g_pos.ticket = ok ? trade.ResultOrder() : 0;
   if(!ok || trade.ResultRetcode() != TRADE_RETCODE_DONE || Quantize(px) != Quantize(bar_open))
      Event("EXEC_DIVERGENCE", StringFormat("open ok=%d retcode=%d price=%s open=%s", ok, trade.ResultRetcode(),
                                            DoubleToString(px, DIGITS + 3), DoubleToString(bar_open, DIGITS)));
  }

void TesterClose(const string why, const double expect_price)
  {
   if(!TesterPositionOpen()) { Event("EXEC_DIVERGENCE", "close " + why + ": tester position already gone"); return; }
   trade.SetTypeFillingBySymbol(g_pos.symbol);
   bool ok = trade.PositionClose(g_pos.ticket);
   double px = trade.ResultPrice();
   if(!ok || trade.ResultRetcode() != TRADE_RETCODE_DONE || Quantize(px) != Quantize(expect_price))
      Event("EXEC_DIVERGENCE", StringFormat("close %s ok=%d retcode=%d price=%s expect=%s", why, ok,
                                            trade.ResultRetcode(), DoubleToString(px, DIGITS + 3),
                                            DoubleToString(expect_price, DIGITS)));
   g_pos.ticket = 0;
  }

void TesterStops(const bool attach_sl, const bool attach_tp)
  {
   if((!attach_sl && !attach_tp) || !TesterPositionOpen()) return;   // nothing to attach: no request at all
   double sl = attach_sl ? g_pos.sl : 0.0;
   double tp = 0.0;
   if(attach_tp) tp = (g_pos.dir > 0) ? g_pos.tp : g_pos.tp + C_RP;   // short TP: + 1 replica point (F2b c9)
   if(!trade.PositionModify(g_pos.ticket, sl, tp))
      Event("EXEC_DIVERGENCE", StringFormat("modify sl=%s tp=%s retcode=%d", DoubleToString(sl, DIGITS + 3),
                                            DoubleToString(tp, DIGITS + 3), trade.ResultRetcode()));
  }

void TesterRemoveStops()
  {
   if(TesterPositionOpen() && (PositionGetDouble(POSITION_SL) != 0.0 || PositionGetDouble(POSITION_TP) != 0.0))
      if(!trade.PositionModify(g_pos.ticket, 0.0, 0.0))
         Event("EXEC_DIVERGENCE", StringFormat("remove stops retcode=%d", trade.ResultRetcode()));
  }

// At the :01 action tick of a tradeable, non-final bar: realise step 3's open-price cases.
void PrepareStops(const double bar_open)
  {
   g_gap_tp = false;
   if(!g_pos.open) return;
   bool lng = g_pos.dir > 0;
   bool sl_now = g_pos.has_sl && (lng ? bar_open <= g_pos.sl : bar_open >= g_pos.sl);
   bool tp_now = g_pos.has_tp && (lng ? bar_open >= g_pos.tp : bar_open <= g_pos.tp);
   if(sl_now) { TesterClose("SL_AT_OPEN", bar_open); return; }        // SL is certain: exit at the open
   if(tp_now && !g_pos.has_sl) { TesterClose("TP_AT_OPEN", bar_open); return; }
   if(tp_now) { g_gap_tp = true; TesterStops(true, false); return; }   // SL may still win in this bar
   TesterStops(g_pos.has_sl, g_pos.has_tp);
  }

//--- kill-switch cooperation ----------------------------------------
bool KillActive(const long now)
  {
   if(!FileIsExist(InpKillFile, FILE_COMMON)) return false;
   int h = FileOpen(InpKillFile, FILE_READ | FILE_TXT | FILE_COMMON | FILE_ANSI);
   if(h == INVALID_HANDLE) return true;
   string line = FileReadString(h);
   FileClose(h);
   if(StringFind(line, "after=") == 0) return now >= (long)StringToInteger(StringSubstr(line, 6));
   return true;
  }

void KillFlatten(const long now)
  {
   for(int k = PositionsTotal() - 1; k >= 0; k--)
     {
      ulong tk = PositionGetTicket(k);
      if(PositionGetInteger(POSITION_MAGIC) != MAGIC) continue;   // own magic only
      trade.SetTypeFillingBySymbol(PositionGetString(POSITION_SYMBOL));
      bool ok = trade.PositionClose(tk);
      Event("KILL", StringFormat("close own ticket=%I64u ok=%d retcode=%d", tk, ok, trade.ResultRetcode()));
     }
   for(int k = OrdersTotal() - 1; k >= 0; k--)
     {
      ulong tk = OrderGetTicket(k);
      if(OrderGetInteger(ORDER_MAGIC) != MAGIC) continue;
      bool ok = trade.OrderDelete(tk);
      Event("KILL", StringFormat("delete own order=%I64u ok=%d", tk, ok));
     }
   Event("KILL", StringFormat("halted at %I64d; own magic flattened, no further trading", now));
   g_halted = true;
  }

//--- bar events ------------------------------------------------------
bool ReadBar(const string sym, const long bar_t, MqlRates &r)
  {
   MqlRates rr[];
   if(CopyRates(sym, PERIOD_H1, 0, 1, rr) != 1 || (long)rr[0].time != bar_t)
     {
      Event("FATAL", StringFormat("CopyRates %s at %I64d failed", sym, bar_t));
      g_halted = true;
      return false;
     }
   r = rr[0];
   return true;
  }

void OnBarOpen(const long bar_t)
  {
   int i = g_i + 1;
   if(i >= N_BARS || g_sp_time[i] != bar_t)
     {
      Event("HISTORY_MISMATCH", StringFormat("bar %d at %I64d where the pinned series expects %I64d", i, bar_t, i < N_BARS ? g_sp_time[i] : -1));
      g_halted = true;
      return;
     }
   MqlRates r, rh;
   if(!ReadBar(SYM_L, bar_t, r) || !ReadBar(SYM_H, bar_t, rh)) return;
   if(rh.open != r.open || !NearRaw(r.open, g_pin_o[i]))
     { Event("HISTORY_MISMATCH", "chart open is not the encoded pinned open or the twins differ"); g_halted = true; return; }
   g_i = i;
   ArrayResize(g_time, i + 1, 65536); ArrayResize(g_open, i + 1, 65536); ArrayResize(g_high, i + 1, 65536);
   ArrayResize(g_low, i + 1, 65536); ArrayResize(g_close, i + 1, 65536); ArrayResize(g_spread, i + 1, 65536);
   g_time[i] = bar_t; g_open[i] = g_pin_o[i]; g_spread[i] = g_sp_spread[i];
   double bar_open = g_pin_o[i];
   int hour = (int)((bar_t / 3600) % 24);
   bool blocked = C_NO_TRADE[hour];
   if(i == N_BARS - 1)
     {
      // engine.py step 6: the final bar -- fills only (same window), no deferred exit, swap or SL/TP.
      if(blocked) { c_blocked_events += g_npend; g_npend = 0; }
      for(int n = 0; n < g_npend; n++) if(g_pending[n].deferred) c_deferred_fills++;
      FillIntents(bar_open, bar_t, i);
      g_npend = 0;
      return;
     }
   // 0. an exit owed from inside the window is taken at this open
   if(g_deferred_exit && !blocked && g_pos.open)
     {
      ShadowClose(bar_open, "SLTP_DEFERRED_ZERO_SPREAD", i, bar_t, bar_open, 0.0, 0.0, 0.0);
      c_sltp_deferred++;
      TesterClose("DEFERRED", bar_open);
      g_deferred_exit = false;
     }
   else if(g_deferred_exit && !blocked) g_deferred_exit = false;
   // A5 max-spread entry gate (entries only, tradeable bars only)
   if(HAS_MAX_SPREAD && !blocked && g_npend > 0 && (double)g_spread[i] > C_MAX_SPREAD)
     {
      int keep = 0;
      for(int n = 0; n < g_npend; n++)
        {
         if(g_pending[n].volume > 0.0) { c_blocked_max_spread++; continue; }
         g_pending[keep++] = g_pending[n];
        }
      g_npend = keep;
     }
   if(blocked)
     {
      c_blocked_events += g_npend;
      for(int n = 0; n < g_npend; n++) g_pending[n].deferred = true;
     }
   else
     {
      for(int n = 0; n < g_npend; n++) if(g_pending[n].deferred) c_deferred_fills++;
      FillIntents(bar_open, bar_t, i);
      g_npend = 0;
     }
   // 2. swap at the day roll
   long day = bar_t / 86400;
   if(g_pos.open && g_last_swap_day >= 0 && day != g_last_swap_day) ChargeSwap(g_last_swap_day, day);
   g_last_swap_day = g_pos.open ? day : -1;
   // 3. (realisation) the open-price cases and the native stops
   if(!blocked) PrepareStops(bar_open);
  }

void OnOpenRevisit(const long bar_t)
  {
   // :03 -- the path is back at the open after the adverse extreme. SL did not fire -> the gapped TP
   // exits at the open (engine: TP, gapped).
   if(!g_gap_tp) return;
   g_gap_tp = false;
   if(TesterPositionOpen()) TesterClose("TP_AT_OPEN_AFTER_ADVERSE", g_open[g_i]);
  }

void OnBarClose(const long bar_t)
  {
   int i = g_i;
   if(i < 0 || g_time[i] != bar_t) { Event("FATAL", "close tick without its open"); g_halted = true; return; }
   MqlRates r, rh;
   if(!ReadBar(SYM_L, bar_t, r) || !ReadBar(SYM_H, bar_t, rh)) return;
   if(rh.high != r.high || rh.low != r.low || rh.close != r.close || rh.open != r.open
      || !NearRaw(r.open, g_pin_o[i]) || !NearRaw(r.high, g_pin_h[i]) || !NearRaw(r.low, g_pin_l[i])
      || !NearRaw(r.close, g_pin_c[i]))
     { Event("HISTORY_MISMATCH", "chart bar is not the encoded pinned bar or the twins differ"); g_halted = true; return; }
   g_high[i] = g_pin_h[i]; g_low[i] = g_pin_l[i]; g_close[i] = g_pin_c[i];
   AppendBar(g_digest, bar_t, g_open[i], g_high[i], g_low[i], g_close[i]);
   AppendBar(g_rdigest, bar_t, r.open, r.high, r.low, r.close);
   UpdateTR(i);
   FamilyUpdate(i);
   double atr_v;
   FileWrite(h_ind, i, bar_t, AtrAt(i, P_ATR_PERIOD, atr_v) ? HB(atr_v) : "", FamilyDump(i));   // level B
   int hour = (int)((bar_t / 3600) % 24);
   bool blocked = C_NO_TRADE[hour];
   bool last = (i == N_BARS - 1);
   if(!last)
     {
      // 3. SL/TP against this bar's range, from the entry bar onward
      if(g_pos.open)
        {
         string touched = CheckSLTP(g_high[i], g_low[i]);
         if(touched != "" && blocked)
           {
            if(!g_deferred_exit) c_blocked_events++;
            g_deferred_exit = true;
           }
         else if(touched != "")
           {
            double exit_price = ExitPriceFor(touched, g_open[i]);
            bool tester_open = TesterPositionOpen();
            ShadowClose(exit_price, touched, i, bar_t, exit_price, 0.0, 0.0, 0.0);
            g_dir = 0;   // strategy_state.pop("direction")
            if(tester_open) { Event("EXEC_DIVERGENCE", "shadow " + touched + " but the tester position is still open"); TesterClose("SHADOW_" + touched, exit_price); }
            g_pos.ticket = 0;
           }
         else if(!TesterPositionOpen())
            Event("EXEC_DIVERGENCE", "shadow holds the position but the tester closed it");
        }
      TesterRemoveStops();
     }
   // 4. mark-to-market at this close
   int ne = ArraySize(g_equity);
   ArrayResize(g_equity, ne + 1, 65536);
   g_equity[ne] = C_INITIAL + g_realised + Unrealised(g_close[i]);
   FileWrite(h_equity, ne, bar_t, HB(g_equity[ne]));
   if(last)
     {
      if(g_pos.open) CountExit("EOD");
      return;
     }
   // 5. the strategy emits an intent for the next open
   Intent x;
   if(FamilyOnBar(i, x))
     {
      FileWrite(h_intents, x.id, i, bar_t, x.dir, HB(x.volume), x.has_sl ? HB(x.sl_dist) : "", x.has_tp ? HB(x.tp_dist) : "", x.reason);
      if(!(x.volume == 0.0 && !g_pos.open))
        {
         ArrayResize(g_pending, g_npend + 1, 64);
         g_pending[g_npend++] = x;
        }
     }
  }

//--- lifecycle --------------------------------------------------------
string RunDir() { return "ARQVIO_S6\\runs\\" + InpRunId + "\\"; }

int OpenCsv(const string name)
  {
   int h = FileOpen(RunDir() + name, FILE_WRITE | FILE_CSV | FILE_COMMON | FILE_ANSI, ',');
   if(h == INVALID_HANDLE) Print("ARQVIO EA cannot open ", RunDir() + name, " err ", GetLastError());
   return h;
  }

bool LoadInputs()
  {
   string base = "ARQVIO_S6\\cells\\" + CELL_NAME + "\\";
   int h = FileOpen(base + "bars.csv", FILE_READ | FILE_CSV | FILE_COMMON | FILE_ANSI, ',');
   if(h == INVALID_HANDLE) { Print("ARQVIO EA: no ", base, "bars.csv"); return false; }
   int n = 0;
   while(!FileIsEnding(h))
     {
      string ts = FileReadString(h);
      if(ts == "") break;
      ArrayResize(g_sp_time, n + 1, 65536); ArrayResize(g_sp_spread, n + 1, 65536);
      ArrayResize(g_pin_o, n + 1, 65536); ArrayResize(g_pin_h, n + 1, 65536);
      ArrayResize(g_pin_l, n + 1, 65536); ArrayResize(g_pin_c, n + 1, 65536);
      g_sp_time[n] = (long)StringToInteger(ts);
      g_pin_o[n] = FromBits((ulong)StringToInteger(FileReadString(h)));
      g_pin_h[n] = FromBits((ulong)StringToInteger(FileReadString(h)));
      g_pin_l[n] = FromBits((ulong)StringToInteger(FileReadString(h)));
      g_pin_c[n] = FromBits((ulong)StringToInteger(FileReadString(h)));
      g_sp_spread[n] = (int)StringToInteger(FileReadString(h));
      n++;
     }
   FileClose(h);
   if(n != N_BARS || g_sp_time[0] != FIRST_TIME || g_sp_time[n - 1] != LAST_TIME)
     { Print("ARQVIO EA: bars.csv has ", n, " rows; the cell has ", N_BARS); return false; }
   h = FileOpen(base + "draws.csv", FILE_READ | FILE_CSV | FILE_COMMON | FILE_ANSI, ',');
   if(h == INVALID_HANDLE) { Print("ARQVIO EA: no ", base, "draws.csv"); return false; }
   n = 0;
   while(!FileIsEnding(h))
     {
      string s = FileReadString(h);
      if(s == "") break;
      ArrayResize(g_draws, n + 1, 65536);
      g_draws[n++] = FromBits((ulong)StringToInteger(s));
     }
   FileClose(h);
   return n > 0;
  }

// Level B primitives: prims.csv rows (kind p|v, input bits) -> prims_out.csv (kind, input bits, Quantize or
// Normalise of the input), for the engine's round(price, digits) and spec.normalise_volume.
bool DumpPrimitives()
  {
   int h = FileOpen("ARQVIO_S6\\cells\\" + CELL_NAME + "\\prims.csv", FILE_READ | FILE_CSV | FILE_COMMON | FILE_ANSI, ',');
   if(h == INVALID_HANDLE) { Print("ARQVIO EA: no prims.csv"); return false; }
   int out = OpenCsv("prims_out.csv");
   if(out == INVALID_HANDLE) { FileClose(h); return false; }
   while(!FileIsEnding(h))
     {
      string kind = FileReadString(h);
      if(kind == "") break;
      string bits = FileReadString(h);
      double x = FromBits((ulong)StringToInteger(bits));
      FileWrite(out, kind, bits, HB(kind == "p" ? Quantize(x) : Normalise(x)));
     }
   FileClose(h);
   FileClose(out);
   return true;
  }

int OnInit()
  {
   if(!MQLInfoInteger(MQL_TESTER)) { Print("ARQVIO EA refuses: S6 generated EAs run in the Strategy Tester only"); return INIT_FAILED; }
   if(InpTemplateVersion != TEMPLATE_VERSION) { Print("ARQVIO EA refuses: template version ", InpTemplateVersion, " != ", TEMPLATE_VERSION); return INIT_FAILED; }
   if(InpRunId == "") { Print("ARQVIO EA refuses: InpRunId is empty"); return INIT_FAILED; }
   InitConstants();
   if(!SymbolSelect(SYM_L, true) || !SymbolSelect(SYM_H, true)) { Print("ARQVIO EA: replica symbols missing"); return INIT_FAILED; }
   if(SymbolInfoInteger(SYM_L, SYMBOL_DIGITS) != DIGITS + 3 || SymbolInfoInteger(SYM_H, SYMBOL_DIGITS) != DIGITS + 3)
     { Print("ARQVIO EA: replica digits are not cell digits + 3"); return INIT_FAILED; }
   if(!LoadInputs() || !DumpPrimitives()) return INIT_FAILED;
   trade.SetExpertMagicNumber(MAGIC);
   trade.SetDeviationInPoints(0);
   g_pos.open = false; g_pos.ticket = 0;
   h_intents = OpenCsv("intents.csv"); h_fills = OpenCsv("fills.csv"); h_trades = OpenCsv("trades.csv");
   h_equity = OpenCsv("equity.csv"); h_events = OpenCsv("events.csv"); h_ind = OpenCsv("indicators.csv");
   if(h_intents == INVALID_HANDLE || h_fills == INVALID_HANDLE || h_trades == INVALID_HANDLE
      || h_equity == INVALID_HANDLE || h_events == INVALID_HANDLE || h_ind == INVALID_HANDLE) return INIT_FAILED;
   ArrayResize(g_equity, 1, 65536);
   g_equity[0] = C_INITIAL;
   FileWrite(h_equity, 0, 0, HB(g_equity[0]));
   Event("INIT", StringFormat("template=%s digest=%s dna=%s cell=%s magic=%I64d n_bars=%d draws=%d",
                               TEMPLATE_VERSION, TEMPLATE_DIGEST, DNA_HASH, CELL_NAME, MAGIC, N_BARS, ArraySize(g_draws)));
   return INIT_SUCCEEDED;
  }

void OnTick()
  {
   long t = (long)TimeCurrent();
   long bar_t = t - t % 3600;
   int minute = (int)((t % 3600) / 60);
   if(g_halted || bar_t < FIRST_TIME || bar_t > LAST_TIME) return;
   if(minute != 1 && minute != 3 && minute != 59) return;
   if(KillActive(t)) { KillFlatten(t); return; }
   static long last_open = -1, last_revisit = -1, last_close = -1;
   if(minute == 1 && bar_t != last_open) { last_open = bar_t; OnBarOpen(bar_t); }
   else if(minute == 3 && bar_t != last_revisit) { last_revisit = bar_t; OnOpenRevisit(bar_t); }
   else if(minute == 59 && bar_t != last_close) { last_close = bar_t; OnBarClose(bar_t); }
  }

string Sha256Hex(const uchar &data[])
  {
   uchar key[], hash[];
   ArrayResize(key, 0);
   string out = "";
   if(CryptEncode(CRYPT_HASH_SHA256, data, key, hash) > 0)
      for(int b = 0; b < ArraySize(hash); b++) out += StringFormat("%02x", hash[b]);
   return out;
  }

// run_slow_trial's metrics from the equity curve, then _apply_funnel's early gates in order. A
// REPORTING label (S6 DR): no gate runs on the EA.
string EarlyGateLabel(double &total_return, double &max_dd)
  {
   int n = ArraySize(g_equity);
   total_return = (n >= 2) ? (g_equity[n - 1] / g_equity[0]) - 1.0 : 0.0;
   max_dd = 0.0;
   if(n >= 2)
     {
      double running = g_equity[0], lowest = 0.0;
      for(int k = 0; k < n; k++)
        {
         running = MathMax(running, g_equity[k]);
         double dd = (g_equity[k] - running) / MathMax(running, 1e-9);
         lowest = (k == 0) ? dd : MathMin(lowest, dd);
        }
      max_dd = -lowest;
     }
   if(g_trades < G_MIN_TRADES) return "LowTrades";
   if(max_dd > G_MAX_DD) return "HighDD";
   if(total_return < G_RET_THRESHOLD) return "NegReturn";
   return "PASSES_EARLY_GATES";
  }

void OnDeinit(const int reason)
  {
   double total_return, max_dd;
   string label = EarlyGateLabel(total_return, max_dd);
   if(g_pos.open) t_swap += g_pos.swap_charged;   // the EOD trade is the last one in the engine's list
   // A position still open when the data ran out: engine EOD (entry side and swap only; no exit fill).
   if(g_pos.open && h_trades != INVALID_HANDLE)
      FileWrite(h_trades, g_trades, g_pos.dir, HB(g_pos.volume), g_pos.entry_signal_bar, g_pos.entry_fill_bar,
                g_pos.entry_time, HB(g_pos.entry_requested), HB(g_pos.entry_filled), HB(g_pos.e_spread),
                HB(g_pos.e_slip), HB(g_pos.e_comm), HB(g_pos.swap_charged),
                g_pos.has_sl ? HB(g_pos.sl) : "", g_pos.has_tp ? HB(g_pos.tp) : "",
                "", "", "", "", "", "", "", HB(0.0), HB(0.0), "EOD");
   string digest = Sha256Hex(g_digest);
   string rdigest = Sha256Hex(g_rdigest);
   int h = OpenCsv("diag.csv");
   if(h != INVALID_HANDLE)
     {
      int n_seen = g_i + 1;
      FileWrite(h, "template_version", TEMPLATE_VERSION);
      FileWrite(h, "template_digest", TEMPLATE_DIGEST);
      FileWrite(h, "dna_hash", DNA_HASH);
      FileWrite(h, "cell", CELL_NAME);
      FileWrite(h, "magic", MAGIC);
      FileWrite(h, "bars_seen", n_seen);
      FileWrite(h, "first_bar_time", n_seen > 0 ? g_time[0] : 0);
      FileWrite(h, "last_bar_time", n_seen > 0 ? g_time[n_seen - 1] : 0);
      FileWrite(h, "history_sha256", digest);
      FileWrite(h, "replica_sha256", rdigest);
      FileWrite(h, "complete", (n_seen == N_BARS && ArraySize(g_equity) == N_BARS + 1) ? 1 : 0);
      FileWrite(h, "n_trades", g_trades);
      FileWrite(h, "n_round_trips", g_round_trips);
      FileWrite(h, "n_open", g_pos.open ? 1 : 0);
      FileWrite(h, "blocked_zero_spread_events", c_blocked_events);
      FileWrite(h, "deferred_zero_spread_fills", c_deferred_fills);
      FileWrite(h, "sltp_deferred_zero_spread", c_sltp_deferred);
      FileWrite(h, "blocked_max_spread", c_blocked_max_spread);
      FileWrite(h, "cost_spread", HB(t_spread));
      FileWrite(h, "cost_slippage", HB(t_slip));
      FileWrite(h, "cost_commission", HB(t_comm));
      FileWrite(h, "cost_swap", HB(t_swap));
      FileWrite(h, "final_equity", HB(g_equity[ArraySize(g_equity) - 1]));
      FileWrite(h, "draws_used", g_k);
      FileWrite(h, "exit_reasons", g_exit_reason_counts);
      FileWrite(h, "total_return", HB(total_return));
      FileWrite(h, "max_dd", HB(max_dd));
      FileWrite(h, "DIAG early_gate_label", label);
      FileWrite(h, "divergences", g_divergences);
      FileWrite(h, "halted", g_halted ? 1 : 0);
      FileWrite(h, "deinit_reason", reason);
      FileClose(h);
     }
   h = OpenCsv("deals.csv");
   if(h != INVALID_HANDLE)
     {
      HistorySelect(0, D'2100.01.01');
      for(int k = 0; k < HistoryDealsTotal(); k++)
        {
         ulong d = HistoryDealGetTicket(k);
         FileWrite(h, d, (long)HistoryDealGetInteger(d, DEAL_TIME), HistoryDealGetString(d, DEAL_SYMBOL),
                   HistoryDealGetInteger(d, DEAL_TYPE), HistoryDealGetInteger(d, DEAL_ENTRY),
                   HB(HistoryDealGetDouble(d, DEAL_PRICE)), HB(HistoryDealGetDouble(d, DEAL_VOLUME)),
                   HistoryDealGetInteger(d, DEAL_REASON), HistoryDealGetInteger(d, DEAL_POSITION_ID),
                   HistoryDealGetInteger(d, DEAL_MAGIC));
        }
      FileClose(h);
     }
   for(int k = 0; k < 6; k++)
     {
      int hh = (k == 0) ? h_intents : (k == 1) ? h_fills : (k == 2) ? h_trades : (k == 3) ? h_equity
               : (k == 4) ? h_events : h_ind;
      if(hh != INVALID_HANDLE) FileClose(hh);
     }
  }
