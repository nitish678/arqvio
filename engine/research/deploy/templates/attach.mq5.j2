//+------------------------------------------------------------------+
//| arqvio_attach.mq5
//| Generated by ARQVIO {{ template_version }} -- do not edit.
//| Full Deploy's in-terminal step: for every bot in MQL5\Files\ARQVIO\deploy_plan.csv it opens a chart of
//| the bot's symbol and timeframe (or finds the chart already running it) and applies the bot's template,
//| whose <expert> block loads the compiled EA with its inputs. Writes deploy_result.csv beside the plan.
//| MQL5 has no call that attaches an EA to a chart; a template is the documented way (ChartApplyTemplate).
//+------------------------------------------------------------------+
#property strict
#property script_show_inputs false

ENUM_TIMEFRAMES PeriodOf(const int minutes)
  {
   switch(minutes)
     {
      case 1: return PERIOD_M1;
      case 5: return PERIOD_M5;
      case 15: return PERIOD_M15;
      case 30: return PERIOD_M30;
      case 60: return PERIOD_H1;
      case 120: return PERIOD_H2;
      case 240: return PERIOD_H4;
      case 1440: return PERIOD_D1;
     }
   return PERIOD_CURRENT;
  }

long ChartRunning(const string expert)
  {
   for(long c = ChartFirst(); c >= 0; c = ChartNext(c))
      if(ChartGetString(c, CHART_EXPERT_NAME) == expert) return c;
   return -1;
  }

void OnStart()
  {
   int plan = FileOpen("ARQVIO\\deploy_plan.csv", FILE_READ | FILE_CSV | FILE_ANSI, ',');
   if(plan == INVALID_HANDLE) { Print("ARQVIO attach: no deploy plan (", GetLastError(), ")"); return; }
   int out = FileOpen("ARQVIO\\deploy_result.csv", FILE_WRITE | FILE_CSV | FILE_ANSI, ',');
   while(!FileIsEnding(plan))
     {
      string expert = FileReadString(plan);
      string symbol = FileReadString(plan);
      int minutes = (int)StringToInteger(FileReadString(plan));
      string tpl = FileReadString(plan);
      if(expert == "") continue;
      string status, detail = "";
      long chart = ChartRunning(expert);
      ENUM_TIMEFRAMES tf = PeriodOf(minutes);
      if(chart >= 0) status = "ALREADY_RUNNING";
      else if(tf == PERIOD_CURRENT) status = "UNKNOWN_TIMEFRAME";
      else if(!SymbolSelect(symbol, true)) { status = "SYMBOL_UNAVAILABLE"; detail = IntegerToString(GetLastError()); }
      else
        {
         chart = ChartOpen(symbol, tf);
         if(chart == 0) { status = "CHART_OPEN_FAILED"; detail = IntegerToString(GetLastError()); }
         else
           {
            Sleep(1500);   // a new chart needs a moment before it accepts a template
            if(!ChartApplyTemplate(chart, "\\Files\\ARQVIO\\tpl\\" + tpl))
              { status = "TEMPLATE_FAILED"; detail = IntegerToString(GetLastError()); }
            else
              {
               status = "NOT_CONFIRMED";
               for(int k = 0; k < 100; k++)   // up to 10 s: the template is applied asynchronously
                 {
                  if(ChartGetString(chart, CHART_EXPERT_NAME) == expert) { status = "ATTACHED"; break; }
                  Sleep(100);
                 }
              }
           }
        }
      Print("ARQVIO attach: ", expert, " ", symbol, " ", minutes, "m -> ", status, " ", detail);
      if(out != INVALID_HANDLE) FileWrite(out, expert, symbol, minutes, status, detail, (long)chart);
     }
   FileClose(plan);
   if(out != INVALID_HANDLE) FileClose(out);
  }
//+------------------------------------------------------------------+
