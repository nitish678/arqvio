   { double mid; if(!SwPrevDayMid(i, mid)) return false; if(dir > 0 ? !(g_close[i] > mid) : !(g_close[i] < mid)) return false; }
{% endif %}
{% if "htf" in bias %}
   if(i < 199) return false;
   { double m = SwMean(g_close, i, 200); if(dir > 0 ? !(g_close[i] > m) : !(g_close[i] < m)) return false; }
{% endif %}
{% if "bb" in filters %}
   if(i < 19) return false;
