//--- exact constants: IEEE-754 bit patterns, never decimal literals (as in the tester EA)
union UBits { ulong u; double d; };
double FromBits(const ulong u) { UBits b; b.u = u; return b.d; }
ulong ToBits(const double d) { UBits b; b.d = d; return b.u; }

//--- numpy-order primitives (the tester EA's, verbatim: the family partials compute with them) ---------
double PwSum(const double &a[], const int lo, const int n)
  {
   if(n < 8)
     {
      double res = 0.0;
      for(int i = 0; i < n; i++) res += a[lo + i];
      return res;
     }
   if(n <= 128)
     {
      double r[8];
      for(int j = 0; j < 8; j++) r[j] = a[lo + j];
      int i = 8;
      for(; i < n - (n % 8); i += 8)
         for(int j = 0; j < 8; j++) r[j] += a[lo + i + j];
      double res = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]));
      for(; i < n; i++) res += a[lo + i];
      return res;
     }
   int n2 = n / 2;
   n2 -= n2 % 8;
   return PwSum(a, lo, n2) + PwSum(a, lo + n2, n - n2);
  }

double PwMean(const double &a[], const int lo, const int n) { return PwSum(a, lo, n) / n; }

string Hex(const ulong u)
  {
   string s = "";
   for(int k = 15; k >= 0; k--) s += StringSubstr("0123456789ABCDEF", (int)((u >> (4 * k)) & 0xF), 1);
   return s;
  }
string HB(const double d) { return Hex(ToBits(d)); }
string B01(const bool b) { return b ? "1" : "0"; }

