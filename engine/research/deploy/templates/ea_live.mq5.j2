// +DI, -DI (simple means of DM and TR over 14 bars ending at j) and ADX = the mean of the last 14 DX values
// (switch_gates._Dmi). full = 14 DX values exist.
void SwDiAt(const int j, double &pdi, double &mdi)
  {
   double p = 0.0, m = 0.0, t = 0.0;
   for(int k = j - 13; k <= j; k++)
     {
      double up = g_high[k] - g_high[k - 1], down = g_low[k - 1] - g_low[k];
      p += (up > down && up > 0.0) ? up : 0.0;
      m += (down > up && down > 0.0) ? down : 0.0;
      t += MathMax(g_high[k] - g_low[k], MathMax(MathAbs(g_high[k] - g_close[k - 1]), MathAbs(g_low[k] - g_close[k - 1])));
     }
   p /= 14.0; m /= 14.0; t /= 14.0;
   pdi = (t > 0.0) ? 100.0 * p / t : 0.0;
   mdi = (t > 0.0) ? 100.0 * m / t : 0.0;
  }

void SwDmi(const int i, double &pdi, double &mdi, double &adx, bool &full)
  {
   SwDiAt(i, pdi, mdi);
   full = (i >= 27);
   adx = 0.0;
   if(!full) return;
   for(int j = i - 13; j <= i; j++)
     {
      double a, b;
      SwDiAt(j, a, b);
      adx += (a + b > 0.0) ? 100.0 * MathAbs(a - b) / (a + b) : 0.0;
     }
   adx /= 14.0;
  }

// The midpoint of the last complete UTC day's high/low before bar i's day (switch_gates.BiasDailyMid).
bool SwPrevDayMid(const int i, double &mid)
  {
   long day = g_time[i] / 86400;
   int k = i;
   while(k >= 0 && g_time[k] / 86400 == day) k--;
   if(k < 0) return false;
   long prev = g_time[k] / 86400;
   double hi = g_high[k], lo = g_low[k];
   while(k >= 0 && g_time[k] / 86400 == prev) { hi = MathMax(hi, g_high[k]); lo = MathMin(lo, g_low[k]); k--; }
   mid = (hi + lo) / 2.0;
   return true;
  }

// Today's (UTC) range so far against 80 % of the mean range of the last 14 complete days (switch_gates.FilterAdrExhaust).
bool SwAdrOk(const int i)
  {
   long day = g_time[i] / 86400;
   int k = i;
   double hi = g_high[i], lo = g_low[i];
   while(k >= 0 && g_time[k] / 86400 == day) { hi = MathMax(hi, g_high[k]); lo = MathMin(lo, g_low[k]); k--; }
   double today = hi - lo, sum = 0.0;
   int days = 0;
   double ranges[14];
   while(k >= 0 && days < 14)
     {
      long d = g_time[k] / 86400;
      double h = g_high[k], l = g_low[k];
      while(k >= 0 && g_time[k] / 86400 == d) { h = MathMax(h, g_high[k]); l = MathMin(l, g_low[k]); k--; }
      ranges[days] = h - l;
      days++;
     }
   if(days < 14) return false;
   for(int x = 13; x >= 0; x--) sum += ranges[x];  // oldest to newest, as the engine's window
   return today < 0.8 * (sum / 14.0);
  }

bool GateOpen(const int i, const int dir)
  {
   if(!SwitchOpen(i, dir)) return false;
   int hour = (int)((g_time[i] / 3600) % 24);
   if(GATE_SESSION != "" && !(hour >= GATE_LO && hour < GATE_HI)) return false;
   if(TREND_EMA > 0)
     {
      if(g_ema_n < TREND_EMA) return false;
      if(dir > 0 ? !(g_close[i] > g_ema) : !(g_close[i] < g_ema)) return false;
     }
   return true;
  }

// The gates act on an opening only: a refused one is dropped and the strategy made flat. An opening let through
// records its signal bar's close (the close rules measure their profit from it, as the oracle's SwitchStrategy).
double g_entry_ref = 0.0;
bool Gate(const Intent &x)
  {
   if(x.volume == 0.0) return true;
   if(GateOpen(g_n - 1, x.dir)) { g_entry_ref = g_close[g_n - 1]; return true; }
   g_dir = 0;
   return false;
  }

// Management close rules (strategies/switch.py friday_close_profit, eod_close): judged on closed bar i while the
// strategy holds a side, before the family; the family does not see a bar they fire on. The close executes at the
// next open like any close intent.
bool MgmtClose(const int i, Intent &out)
  {
   if(g_dir == 0 || (InpFridayCloseProfitPct <= 0.0 && InpEodCloseHour < 0)) return false;
   bool fire = false;
   if(InpFridayCloseProfitPct > 0.0 && ((g_time[i] / 86400) + 3) % 7 == 4)
     {
      double move = (g_close[i] - g_entry_ref) * g_dir;
      if(move > 0.0)
        {
         double atr = 0.0;
         double risk = AtrAt(i, 14, atr) ? P_SL_ATR * atr : MathMax(move, 1e-9);
         if(move >= (InpFridayCloseProfitPct / 100.0) * risk) fire = true;
        }
     }
   if(!fire && InpEodCloseHour >= 0 && (int)((g_time[i] / 3600) % 24) >= InpEodCloseHour) fire = true;
   if(!fire) return false;
   out = MakeIntent(g_dir, 0.0, i, "MGMT_CLOSE", false, 0.0, false, 0.0);
   g_dir = 0;
   return true;
  }

// InpJoinCurrentState: after the replay, a strategy that is LONG or SHORT (and this bot flat) opens that side now,
// at today's price with stops from the newest closed bar's ATR -- the backtest entered at the signal, so this entry
// differs from it by design and says so in the log. Once per start; every guard of Act() still applies.
bool g_joined = false;
void JoinCurrentState()
  {
   if(!InpJoinCurrentState || g_joined || !g_ready || g_dir == 0 || g_n < 1) return;
   g_joined = true;
   int dir; double vol, profit;
   if(OwnPositions(dir, vol, profit) > 0) { Log("JOIN_SKIPPED", "a position of this bot is already open"); return; }
   if(!GateOpen(g_n - 1, g_dir)) { Log("JOIN_SKIPPED", "the session / trend gate is closed for that side now"); return; }
   bool suppress, hs, ht; double sd, td;
   StopDistances(g_n - 1, P_SL_ATR, P_TP_ATR, P_ATR_PERIOD, suppress, hs, sd, ht, td);
   if(suppress) { Log("JOIN_SKIPPED", "no ATR yet for the stops"); return; }
   Log("JOIN", StringFormat("strategy %s since the last signal: joining now (InpJoinCurrentState)", g_dir > 0 ? "LONG" : "SHORT"));
   Act(MakeIntent(g_dir, P_VOLUME, g_n - 1, "JOIN_CURRENT_STATE", hs, sd, ht, td));
  }

// Replay the closed history once: indicators and the strategy's own state, no orders.
bool Replay()
  {
   MqlRates rr[];
   int n = CopyRates(_Symbol, _Period, 1, InpHistoryBars, rr);
   if(n <= 0) return false;
   for(int k = 0; k < n; k++)
     {
      Ingest(rr[k]);
      Intent x;
      if(!MgmtClose(g_n - 1, x) && FamilyOnBar(g_n - 1, x)) Gate(x);
     }
   Log("READY", StringFormat("replayed %d closed bars, strategy state %d", n, g_dir));
   return true;
  }

// New closed bars since the last call: each updates the state; only the newest one's intent trades.
void Poll()
  {
   MqlRates rr[];
   int n = CopyRates(_Symbol, _Period, 1, 64, rr);
   if(n <= 0) return;
   int first = -1;
   for(int k = 0; k < n; k++) if((long)rr[k].time > g_last_time) { first = k; break; }
   if(first < 0) return;
   for(int k = first; k < n; k++)
     {
      Ingest(rr[k]);
      if(k == n - 1) ManageStops(rr[k].close);
      Intent x;
      if(MgmtClose(g_n - 1, x)) { if(k == n - 1) Act(x); }
      else if(FamilyOnBar(g_n - 1, x) && Gate(x) && k == n - 1)
        {
         g_last_signal_time = (long)rr[k].time;
         Act(x);
        }
     }
  }

string J(const string s) { return "\"" + s + "\""; }

void Heartbeat()
  {
   if(g_tester) return;   // a test never overwrites the live bot's heartbeat
   int dir; double vol, profit;
   int own = OwnPositions(dir, vol, profit);
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   double day_pct = (g_day_balance > 0.0) ? (equity - g_day_balance) / g_day_balance * 100.0 : 0.0;
   string reason; color sc; double cap;
   string status = BotStatus(reason, sc, cap);
   string body = "{" + J("schema") + ":" + J("arqvio.bot_heartbeat") + "," + J("version") + ":1,"
      + J("bot") + ":" + J(BOT_NAME) + "," + J("magic") + ":" + IntegerToString(MAGIC) + ","
      + J("dna_hash") + ":" + J(DNA_HASH) + "," + J("template_version") + ":" + J(TEMPLATE_VERSION) + ","
      + J("symbol") + ":" + J(_Symbol) + "," + J("timeframe") + ":" + J(EnumToString(_Period)) + ","
      + J("server_time") + ":" + IntegerToString((long)TimeCurrent()) + ","
      + J("utc_time") + ":" + IntegerToString((long)TimeGMT()) + ","
      + J("ready") + ":" + (g_ready ? "true" : "false") + "," + J("bars") + ":" + IntegerToString(g_n) + ","
      + J("last_bar_time") + ":" + IntegerToString(g_last_time) + ","
      + J("last_signal_time") + ":" + IntegerToString(g_last_signal_time) + ","
      + J("strategy_state") + ":" + IntegerToString(g_dir) + ","
      + J("standby") + ":" + J(g_standby) + "," + J("last_event") + ":" + J(g_last_event) + ","
      + J("status") + ":" + J(status) + "," + J("reason") + ":" + J(reason) + ","
      + J("lots") + ":" + DoubleToString(NormaliseLots(InpLots * InpLotScale), 2) + ","
      + J("lot_scale") + ":" + DoubleToString(InpLotScale, 2) + ","
      + J("position") + ":" + (own > 0 ? "{" + J("dir") + ":" + IntegerToString(dir) + "," + J("volume") + ":"
                                         + DoubleToString(vol, 2) + "," + J("profit") + ":" + DoubleToString(profit, 2) + "}"
                                       : "null") + ","
      + J("day_pnl_pct") + ":" + DoubleToString(day_pct, 3) + "}";
   string tmp = FILES_DIR + "bots\\" + IntegerToString(MAGIC) + ".tmp";
   string dst = FILES_DIR + "bots\\" + IntegerToString(MAGIC) + ".json";
   int h = FileOpen(tmp, FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_ANSI);
   if(h == INVALID_HANDLE) return;
   FileWriteString(h, body);
   FileClose(h);
   FileMove(tmp, FILE_COMMON, dst, FILE_COMMON | FILE_REWRITE);
   g_last_beat = TimeCurrent();
  }

//--- the ARQVIO dashboard (ARQVIO_V4.md section 11) -------------------------------------------------------
// Every number on it is read from the terminal now (positions, deal history by magic, the symbol's spread) or is
// this EA's own guard state; nothing is estimated. One status at a time, with its reason.
#define DASH "ARQVIO_DASH_"
{% include "arqvio_logo.j2" %}
#define DASH_LINES 16
#define DASH_WRAP 58
double g_tot_net = 0.0, g_tot_win = 0.0, g_tot_loss = 0.0;
int g_tot_trades = 0, g_tot_w = 0, g_tot_l = 0;
datetime g_tot_at = 0;
uint g_dash_tick = 0;

void Totals()
  {
   g_tot_net = 0.0; g_tot_win = 0.0; g_tot_loss = 0.0; g_tot_trades = 0; g_tot_w = 0; g_tot_l = 0;
   if(!HistorySelect(0, TimeCurrent() + 86400)) return;
   int n = HistoryDealsTotal();
   for(int k = 0; k < n; k++)
     {
      ulong d = HistoryDealGetTicket(k);
      if(d == 0 || HistoryDealGetInteger(d, DEAL_MAGIC) != MAGIC || HistoryDealGetString(d, DEAL_SYMBOL) != _Symbol) continue;
      long entry = HistoryDealGetInteger(d, DEAL_ENTRY);
      double pnl = HistoryDealGetDouble(d, DEAL_PROFIT) + HistoryDealGetDouble(d, DEAL_SWAP)
                   + HistoryDealGetDouble(d, DEAL_COMMISSION);
      g_tot_net += pnl;
      if(entry != DEAL_ENTRY_OUT && entry != DEAL_ENTRY_OUT_BY && entry != DEAL_ENTRY_INOUT) continue;
      g_tot_trades++;
      if(pnl >= 0.0) { g_tot_w++; g_tot_win += pnl; } else { g_tot_l++; g_tot_loss += pnl; }
     }
   g_tot_at = TimeCurrent();
  }

void DashLine(const int row, const string text, const color c)
  {
   string name = DASH + IntegerToString(row);
   if(ObjectFind(0, name) < 0)
     {
      ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, name, OBJPROP_CORNER, InpDashboardCorner);
      ObjectSetInteger(0, name, OBJPROP_ANCHOR, (InpDashboardCorner == 2 || InpDashboardCorner == 3) ? ANCHOR_RIGHT_UPPER
                                                                                                     : ANCHOR_LEFT_UPPER);
      ObjectSetString(0, name, OBJPROP_FONT, "Consolas");
      ObjectSetInteger(0, name, OBJPROP_FONTSIZE, row == 0 ? 11 : 9);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
     }
   bool bottom = InpDashboardCorner == 1 || InpDashboardCorner == 2;
   int y = bottom ? 18 + (DASH_LINES - row) * 16 : (row == 0 ? 14 : 30 + row * 16);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, row == 0 ? 16 + ARQVIO_LOGO_SIZE + 8 : 16);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, row == 0 ? y + 4 : y);
   ObjectSetInteger(0, name, OBJPROP_COLOR, c);
   ObjectSetString(0, name, OBJPROP_TEXT, text == "" ? " " : text);
  }

void DashPanel()
  {
   string name = DASH + "BG";
   if(ObjectFind(0, name) < 0)
     {
      ObjectCreate(0, name, OBJ_RECTANGLE_LABEL, 0, 0, 0);
      ObjectSetInteger(0, name, OBJPROP_CORNER, InpDashboardCorner);
      ObjectSetInteger(0, name, OBJPROP_BGCOLOR, C'14,14,18');
      ObjectSetInteger(0, name, OBJPROP_BORDER_TYPE, BORDER_FLAT);
      ObjectSetInteger(0, name, OBJPROP_COLOR, C'200,30,60');
      ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, name, OBJPROP_BACK, false);
     }
   bool right = InpDashboardCorner == 2 || InpDashboardCorner == 3;
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, right ? 470 : 8);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, (InpDashboardCorner == 1 || InpDashboardCorner == 2) ? 18 + (DASH_LINES + 1) * 16 + 4 : 10);
   ObjectSetInteger(0, name, OBJPROP_XSIZE, 462);
   ObjectSetInteger(0, name, OBJPROP_YSIZE, (DASH_LINES + 1) * 16 + 28);
   // the ARQVIO mark: a bitmap resource built from the pixel array above, once per chart
   string logo = DASH + "LOGO";
   if(ObjectFind(0, logo) < 0)
     {
      if(ResourceCreate("::ARQVIO_LOGO", ARQVIO_LOGO, ARQVIO_LOGO_SIZE, ARQVIO_LOGO_SIZE, 0, 0, ARQVIO_LOGO_SIZE,
                        COLOR_FORMAT_ARGB_NORMALIZE))
        {
         ObjectCreate(0, logo, OBJ_BITMAP_LABEL, 0, 0, 0);
         ObjectSetString(0, logo, OBJPROP_BMPFILE, 0, "::ARQVIO_LOGO");
         ObjectSetInteger(0, logo, OBJPROP_CORNER, InpDashboardCorner);
         ObjectSetInteger(0, logo, OBJPROP_ANCHOR, right ? ANCHOR_RIGHT_UPPER : ANCHOR_LEFT_UPPER);
         ObjectSetInteger(0, logo, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, logo, OBJPROP_HIDDEN, true);
        }
     }
   bool bottom = InpDashboardCorner == 1 || InpDashboardCorner == 2;
   ObjectSetInteger(0, logo, OBJPROP_XDISTANCE, 16);
   ObjectSetInteger(0, logo, OBJPROP_YDISTANCE, bottom ? 18 + DASH_LINES * 16 + 2 : 14);
  }

string Money(const double v) { return (v >= 0.0 ? "+" : "") + DoubleToString(v, 2); }

// The entry guard that would refuse an opening right now ("" = none); the same checks Act() runs.
string BlockNow(double &cap_out)
  {
   cap_out = RegimeCap();
   long spread = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   if(C_NO_TRADE[dt.hour]) return StringFormat("no-trade hour %d of the cell", dt.hour);
   if(InpMaxSpreadPoints > 0 && spread > InpMaxSpreadPoints) return StringFormat("spread %I64d > %d points", spread, InpMaxSpreadPoints);
   if(cap_out > 0.0 && (double)spread > cap_out) return StringFormat("spread %I64d > %.1f points (regime cap)", spread, cap_out);
   if(ArqvioPositions() >= InpMaxAccountPositions)
      return StringFormat("%d ARQVIO positions open (cap %d)", ArqvioPositions(), InpMaxAccountPositions);
   string news = "";
   if(NewsBlocked(news)) return news;
   return "";
  }

string Tf(const ENUM_TIMEFRAMES p) { return StringSubstr(EnumToString(p), 7); }

// The one status (and its reason) the chart dashboard shows and the heartbeat file reports (spec 11.2).
string BotStatus(string &why, color &sc, double &cap)
  {
   int dir; double vol, profit;
   int own = OwnPositions(dir, vol, profit);
   cap = -1.0;
   string block = BlockNow(cap);
   if(!g_ready)         { sc = clrSilver;      why = StringFormat("history not replayed yet (%d bars, need %d)", Bars(_Symbol, _Period), InpHistoryBars); return "NOT READY"; }
   if(g_standby != "")  { sc = C'255,70,90';   why = g_standby;           return "STANDBY"; }
   if(own > 0)          { sc = clrLime;        why = "own position open"; return "LIVE - IN TRADE"; }
   if(block != "")      { sc = clrGold;        why = block;               return "BLOCKED"; }
   sc = clrDeepSkyBlue;
   why = g_dir == 0 ? "strategy flat; enters on the next signal"
       : StringFormat("strategy %s since the last signal; joins on the next one", g_dir > 0 ? "LONG" : "SHORT");
   return "LIVE - WAITING FOR SIGNAL";
  }

void Dash()
  {
   if(!InpShowDashboard) return;
   if(g_tester && !MQLInfoInteger(MQL_VISUAL_MODE)) return;   // nobody sees a chart in a non-visual test
   if(g_tot_at == 0 || TimeCurrent() - g_tot_at > 60) Totals();
   int dir; double vol, profit;
   int own = OwnPositions(dir, vol, profit);
   double cap = -1.0;
   string why; color sc;
   string status = BotStatus(why, sc, cap);
   bool chart_ok = _Symbol == LOCK_SYMBOL && _Period == LOCK_PERIOD;
   if(g_tester && !chart_ok) why = StringFormat("[test on %s %s] ", _Symbol, Tf(_Period)) + why;
   string why2 = "";
   if(StringLen(why) > DASH_WRAP)
     {
      int cut = DASH_WRAP;
      while(cut > 20 && StringGetCharacter(why, cut) != ' ') cut--;
      why2 = StringSubstr(why, cut + 1, DASH_WRAP);
      why = StringSubstr(why, 0, cut);
     }
   long secs = (long)PeriodSeconds(_Period) - (long)(TimeCurrent() - iTime(_Symbol, _Period, 0));
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   double day = (g_day_balance > 0.0) ? equity - g_day_balance : 0.0;
   double day_pct = (g_day_balance > 0.0) ? day / g_day_balance * 100.0 : 0.0;
   long spread = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   string spread_cap = (cap > 0.0) ? StringFormat("cap %.1f (%.1fx median %d bars)", cap, InpSpreadRegimeMultiple, InpSpreadRegimeBars)
                     : (InpMaxSpreadPoints > 0 ? StringFormat("cap %d", InpMaxSpreadPoints) : "no cap");
   bool spread_hi = (cap > 0.0 && (double)spread > cap) || (InpMaxSpreadPoints > 0 && spread > InpMaxSpreadPoints);
   string news = "";
   bool news_on = NewsBlocked(news);
   bool algo = TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) != 0 && MQLInfoInteger(MQL_TRADE_ALLOWED) != 0;
   bool stop_file = !g_tester && FileIsExist(STOP_FILE, FILE_COMMON);
   DashPanel();
   DashLine(0, "ARQVIO   " + TEMPLATE_VERSION + "   * " + status, sc);
   DashLine(1, StringFormat("%s  %s %s  #%I64d", FAMILY_NAME, LOCK_SYMBOL, Tf(LOCK_PERIOD), MAGIC), clrSilver);
   DashLine(2, "STATUS   " + status, sc);
   DashLine(3, "why      " + why, clrWhite);
   DashLine(4, why2 == "" ? " " : "         " + why2, clrWhite);
   DashLine(5, StringFormat("next     bar close in %02d:%02d", (int)MathMax(0, secs) / 60, (int)MathMax(0, secs) % 60), clrSilver);
   DashLine(6, own > 0 ? StringFormat("POSITION %s %.2f   %s USD", dir > 0 ? "BUY" : "SELL", vol, Money(profit)) : "POSITION none",
            own > 0 ? (profit >= 0.0 ? clrLime : C'255,70,90') : clrSilver);
   DashLine(7, StringFormat("TODAY    %s USD (%+.2f%%)   limit -%.1f%%", Money(day), day_pct, InpDailyLossPct), day >= 0.0 ? clrLime : C'255,70,90');
   DashLine(8, StringFormat("TOTAL    %s USD  %d trades  %dW/%dL", Money(g_tot_net), g_tot_trades, g_tot_w, g_tot_l), g_tot_net >= 0.0 ? clrLime : C'255,70,90');
   DashLine(9, StringFormat("PROFIT   %s   LOSS %s", Money(g_tot_win), Money(g_tot_loss)), clrSilver);
   DashLine(10, StringFormat("SPREAD   %I64d pts   %s   %s", spread, spread_cap, spread_hi ? "HIGH" : "OK"), spread_hi ? clrGold : clrSilver);
   DashLine(11, "NEWS     " + (news_on ? news : (InpNewsBlockMinutes > 0 && !g_tester ? StringFormat("none in +-%d min", InpNewsBlockMinutes) : "filter off")),
            news_on ? clrGold : clrSilver);
   DashLine(12, StringFormat("RISK     ARQVIO positions %d / %d", ArqvioPositions(), InpMaxAccountPositions), clrSilver);
   DashLine(13, StringFormat("ALGO     %s     STOP file: %s", algo ? "ON" : "OFF", stop_file ? "yes" : "no"), algo && !stop_file ? clrSilver : C'255,70,90');
   DashLine(14, StringFormat("LOT      %.2f x %.2f = %.2f", InpLots, InpLotScale, NormaliseLots(InpLots * InpLotScale)), clrSilver);
   DashLine(15, g_last_refusal == "" ? "LAST     no entry refused" : "LAST     refused " + TimeToString(g_last_refusal_time, TIME_DATE | TIME_MINUTES) + ": " + g_last_refusal,
            g_last_refusal == "" ? clrSilver : clrGold);
   DashLine(16, g_tester ? "BEAT     Strategy Tester (no heartbeat file)" : StringFormat("BEAT     heartbeat %d s ago", (int)(TimeCurrent() - g_last_beat)), clrSilver);
   ChartRedraw(0);
  }

void DashDelete() { ObjectsDeleteAll(0, DASH); ResourceFree("::ARQVIO_LOGO"); ChartRedraw(0); }

// The live trade ledger (spec 2.4): every deal of this bot, one JSON line each, in ARQVIO\bots\<magic>.ledger.jsonl
// (Common Files). Written from the terminal's own deal record, never from what the EA asked for.
void Ledger(const ulong deal)
  {
   if(g_tester || !HistoryDealSelect(deal)) return;   // a test never writes into the live bot's ledger
   if(HistoryDealGetInteger(deal, DEAL_MAGIC) != MAGIC || HistoryDealGetString(deal, DEAL_SYMBOL) != _Symbol) return;
   long entry = HistoryDealGetInteger(deal, DEAL_ENTRY), type = HistoryDealGetInteger(deal, DEAL_TYPE);
   string line = "{" + J("schema") + ":" + J("arqvio.bot_ledger") + "," + J("version") + ":1,"
      + J("deal") + ":" + IntegerToString((long)deal) + ","
      + J("position") + ":" + IntegerToString(HistoryDealGetInteger(deal, DEAL_POSITION_ID)) + ","
      + J("server_time") + ":" + IntegerToString(HistoryDealGetInteger(deal, DEAL_TIME)) + ","
      + J("entry") + ":" + J(entry == DEAL_ENTRY_IN ? "IN" : entry == DEAL_ENTRY_OUT ? "OUT" : entry == DEAL_ENTRY_INOUT ? "INOUT" : "OUT_BY") + ","
      + J("side") + ":" + J(type == DEAL_TYPE_BUY ? "BUY" : type == DEAL_TYPE_SELL ? "SELL" : "OTHER") + ","
      + J("volume") + ":" + DoubleToString(HistoryDealGetDouble(deal, DEAL_VOLUME), 2) + ","
      + J("price") + ":" + DoubleToString(HistoryDealGetDouble(deal, DEAL_PRICE), _Digits) + ","
      + J("profit") + ":" + DoubleToString(HistoryDealGetDouble(deal, DEAL_PROFIT), 2) + ","
      + J("commission") + ":" + DoubleToString(HistoryDealGetDouble(deal, DEAL_COMMISSION), 2) + ","
      + J("swap") + ":" + DoubleToString(HistoryDealGetDouble(deal, DEAL_SWAP), 2) + ","
      + J("dna_hash") + ":" + J(DNA_HASH) + "}";
   int h = FileOpen(FILES_DIR + "bots\\" + IntegerToString(MAGIC) + ".ledger.jsonl",
                    FILE_READ | FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_ANSI | FILE_SHARE_READ);
   if(h == INVALID_HANDLE) { Log("LEDGER_FAILED", StringFormat("deal %I64u: error %d", deal, GetLastError())); return; }
   FileSeek(h, 0, SEEK_END);
   FileWriteString(h, line + "\n");
   FileClose(h);
  }

void OnTradeTransaction(const MqlTradeTransaction &trans, const MqlTradeRequest &request, const MqlTradeResult &result)
  {
   if(trans.type != TRADE_TRANSACTION_DEAL_ADD) return;
   g_tot_at = 0;   // the next Dash() re-reads the deal history
   Ledger(trans.deal);
  }

int OnInit()
  {
   g_tester = MQLInfoInteger(MQL_TESTER) != 0;
   if(_Symbol != LOCK_SYMBOL || _Period != LOCK_PERIOD)
     {
      if(!g_tester)
        {
         Print("ARQVIO ", BOT_NAME, " refuses: it trades ", LOCK_SYMBOL, " ", EnumToString(LOCK_PERIOD), " only, not ",
               _Symbol, " ", EnumToString(_Period));
         return INIT_PARAMETERS_INCORRECT;
        }
      Print("ARQVIO ", BOT_NAME, ": bred on ", LOCK_SYMBOL, " ", EnumToString(LOCK_PERIOD), ", tested here on ",
            _Symbol, " ", EnumToString(_Period));
     }
   if(InpLots <= 0.0 || InpLotScale <= 0.0 || InpLotScale > 1.0 || InpMaxAccountPositions < 1 || InpHistoryBars < 100)
     {
      Print("ARQVIO ", BOT_NAME, " refuses: lots and scale must be > 0 (scale <= 1), the position cap >= 1, history >= 100");
      return INIT_PARAMETERS_INCORRECT;
     }
{% for nt in no_trade %}
   C_NO_TRADE[{{ loop.index0 }}] = {{ "true" if nt else "false" }};
{% endfor %}
   FamilyInitConstants();
   FolderCreate("ARQVIO", FILE_COMMON);
   FolderCreate("ARQVIO\\bots", FILE_COMMON);
   trade.SetExpertMagicNumber(MAGIC);
   trade.SetDeviationInPoints(InpSlippagePoints);
   trade.SetTypeFillingBySymbol(_Symbol);
   g_start_balance = AccountInfoDouble(ACCOUNT_BALANCE);
   g_ready = Replay();
   Guard();
   JoinCurrentState();
   EventSetTimer(1);   // the dashboard each second; the heartbeat file every 15
   Guard();
   Heartbeat();
   Totals();
   Dash();
   Log("INIT", StringFormat("%s %s magic %I64d lots %.2f x %.2f%s", _Symbol, EnumToString(_Period), MAGIC,
                            InpLots, InpLotScale, g_tester ? " (Strategy Tester)" : ""));
   return INIT_SUCCEEDED;
  }

void OnTick()
  {
   if(!g_ready) return;
   Guard();
   Poll();
   if(g_tester && GetTickCount() - g_dash_tick > 1000) { g_dash_tick = GetTickCount(); Dash(); }   // the tester has no timer
  }

int g_timer_n = 0;
void OnTimer()
  {
   if(!g_ready) { g_ready = Replay(); if(g_ready) { Guard(); JoinCurrentState(); } }
   Guard();
   if(g_timer_n++ % 15 == 0) Heartbeat();
   Dash();
  }

void OnDeinit(const int reason)
  {
   EventKillTimer();
   Log("DEINIT", StringFormat("reason %d", reason));
   g_standby = StringFormat("removed from the chart (reason %d)", reason);
   Heartbeat();
   DashDelete();
  }
