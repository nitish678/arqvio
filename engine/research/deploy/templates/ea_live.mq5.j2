void Log(const string kind, const string detail)
  {
   g_last_event = kind + ": " + detail;
   Print("ARQVIO ", BOT_NAME, " ", kind, ": ", detail);
   if(g_tester) return;   // a test never writes the live bot's log
   int h = FileOpen(FILES_DIR + "bots\\" + IntegerToString(MAGIC) + ".log",
                    FILE_READ | FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_ANSI);
   if(h == INVALID_HANDLE) return;
   FileSeek(h, 0, SEEK_END);
   FileWriteString(h, TimeToString(TimeCurrent(), TIME_DATE | TIME_SECONDS) + "|" + kind + "|" + detail + "\r\n");
   FileClose(h);
  }

int OwnPositions(int &dir, double &volume, double &profit)
  {
   int n = 0;
   dir = 0; volume = 0.0; profit = 0.0;
   for(int k = PositionsTotal() - 1; k >= 0; k--)
     {
      ulong t = PositionGetTicket(k);
      if(t == 0 || PositionGetInteger(POSITION_MAGIC) != MAGIC || PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      n++;
      dir = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? 1 : -1;
      volume += PositionGetDouble(POSITION_VOLUME);
      profit += PositionGetDouble(POSITION_PROFIT);
     }
   return n;
  }

int ArqvioPositions()
  {
   int n = 0;
   for(int k = PositionsTotal() - 1; k >= 0; k--)
     {
      ulong t = PositionGetTicket(k);
      long m = (t == 0) ? 0 : PositionGetInteger(POSITION_MAGIC);
      if(m >= MAGIC_MIN && m <= MAGIC_MAX) n++;
     }
   return n;
  }

// Management genes that move the stop (the oracle's BacktestConfig breakeven_at_r, sl_reduce_at_r, sl_lock_at_r,
// atr_trail; engine.py _breakeven / _stop_rules): judged on a closed bar, in that order, each only ever towards the
// trade. R is the stop distance the position opened with: the opening order's own stop, read from the history, so a
// moved stop or an EA restart never changes it.
double InitialRisk(const double open)
  {
   ulong id = (ulong)PositionGetInteger(POSITION_IDENTIFIER);
   if(!HistoryOrderSelect(id)) return 0.0;
   double sl = HistoryOrderGetDouble(id, ORDER_SL);
   return (sl > 0.0) ? MathAbs(open - sl) : 0.0;
  }

void MoveStop(const ulong t, const int pdir, const double raw, const double tp, double &sl, const string rule)
  {
   double level = NormalizeDouble(raw, _Digits);
   if((level - sl) * pdir <= 0.0) return;   // only ever towards the trade
   if(trade.PositionModify(t, level, tp))
     {
      Log(rule, StringFormat("ticket %I64u stop %s -> %s", t, DoubleToString(sl, _Digits), DoubleToString(level, _Digits)));
      sl = level;
     }
   else
      Log(rule + "_FAILED", StringFormat("ticket %I64u retcode %u %s", t, trade.ResultRetcode(), trade.ResultRetcodeDescription()));
  }

void ManageStops(const double close)
  {
   bool trail = InpAtrTrailK > 0.0 && InpAtrTrailAtR > 0.0;
   if(InpBreakevenAtR <= 0.0 && InpSlReduceAtR <= 0.0 && InpSlLockAtR <= 0.0 && !trail) return;
   double atr = 0.0;
   bool has_atr = trail && AtrAt(g_n - 1, 14, atr);
   for(int k = PositionsTotal() - 1; k >= 0; k--)
     {
      ulong t = PositionGetTicket(k);
      if(t == 0 || PositionGetInteger(POSITION_MAGIC) != MAGIC || PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      double open = PositionGetDouble(POSITION_PRICE_OPEN), sl = PositionGetDouble(POSITION_SL), tp = PositionGetDouble(POSITION_TP);
      if(sl <= 0.0) continue;
      int pdir = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? 1 : -1;
      double r = InitialRisk(open);
      if(r <= 0.0) continue;
      double gain = (close - open) * pdir;
      if(InpBreakevenAtR > 0.0 && gain >= InpBreakevenAtR * r) MoveStop(t, pdir, open, tp, sl, "BREAKEVEN");
      if(InpSlReduceAtR > 0.0 && gain >= InpSlReduceAtR * r) MoveStop(t, pdir, open - pdir * (0.5 * r), tp, sl, "SL_REDUCE");
      if(InpSlLockAtR > 0.0 && gain >= InpSlLockAtR * r) MoveStop(t, pdir, open + pdir * (0.5 * InpSlLockAtR * r), tp, sl, "SL_LOCK");
      if(has_atr && gain >= InpAtrTrailAtR * r) MoveStop(t, pdir, close - pdir * (InpAtrTrailK * atr), tp, sl, "ATR_TRAIL");
     }
  }

// Close this bot's own positions on this symbol (dir 0 = every direction). Closing is always allowed.
void CloseOwn(const int dir, const string why)
  {
   for(int k = PositionsTotal() - 1; k >= 0; k--)
     {
      ulong t = PositionGetTicket(k);
      if(t == 0 || PositionGetInteger(POSITION_MAGIC) != MAGIC || PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      int pdir = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? 1 : -1;
      if(dir != 0 && pdir != dir) continue;
      if(trade.PositionClose(t)) Log("CLOSE", StringFormat("ticket %I64u (%s)", t, why));
      else Log("CLOSE_FAILED", StringFormat("ticket %I64u (%s) retcode %u", t, why, trade.ResultRetcode()));
     }
  }

double NormaliseLots(const double lots)
  {
   double vmin = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN), vmax = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double vstep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double v = (vstep > 0.0) ? MathRound(lots / vstep) * vstep : lots;
   return MathMax(vmin, MathMin(vmax, v));   // below the broker minimum: the minimum lot
  }

bool NewsBlocked(string &why)
  {
   if(InpNewsBlockMinutes <= 0 || g_tester) return false;   // the tester has no economic calendar
   datetime now = TimeCurrent();
   string ccy[2];
   ccy[0] = SymbolInfoString(_Symbol, SYMBOL_CURRENCY_BASE);
   ccy[1] = SymbolInfoString(_Symbol, SYMBOL_CURRENCY_PROFIT);
   for(int c = 0; c < 2; c++)
     {
      MqlCalendarValue values[];
      if(CalendarValueHistory(values, now - InpNewsBlockMinutes * 60, now + InpNewsBlockMinutes * 60, NULL, ccy[c]) <= 0)
         continue;
      for(int k = 0; k < ArraySize(values); k++)
        {
         MqlCalendarEvent ev;
         if(CalendarEventById(values[k].event_id, ev) && ev.importance == CALENDAR_IMPORTANCE_HIGH)
           {
            why = "high-impact " + ccy[c] + " event " + ev.name;
            return true;
           }
        }
     }
   return false;
  }

// Account-level guards, refreshed every tick and timer: they flatten this bot when they fire.
void Guard()
  {
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   int day = dt.year * 10000 + dt.mon * 100 + dt.day;
   double balance = AccountInfoDouble(ACCOUNT_BALANCE), equity = AccountInfoDouble(ACCOUNT_EQUITY);
   if(day != g_day) { g_day = day; g_day_balance = balance; g_day_locked = false; }
   g_standby = "";
   if(!g_tester && FileIsExist(STOP_FILE, FILE_COMMON)) g_standby = "STOP file present (Stop all bots in ARQVIO)";
   else if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) || !MQLInfoInteger(MQL_TRADE_ALLOWED))
      g_standby = "algo trading is not allowed in the terminal or for this EA";
   else if(g_target_hit) g_standby = "profit target reached";
   else if(InpDailyLossPct > 0.0 && g_day_balance > 0.0 && (equity - g_day_balance) / g_day_balance * 100.0 <= -InpDailyLossPct)
     {
      if(!g_day_locked) Log("DAILY_LOSS", StringFormat("equity %.2f vs day start %.2f", equity, g_day_balance));
      g_day_locked = true;
     }
   if(g_standby == "" && g_day_locked) g_standby = "daily loss limit reached";
   if(g_standby == "" && InpProfitTargetPct > 0.0 && g_start_balance > 0.0
      && equity >= g_start_balance * (1.0 + InpProfitTargetPct / 100.0))
     {
      g_target_hit = true;
      Log("PROFIT_TARGET", StringFormat("equity %.2f vs start %.2f", equity, g_start_balance));
      g_standby = "profit target reached";
     }
   bool friday = InpFridayCloseHour >= 0 && ((dt.day_of_week == 5 && dt.hour >= InpFridayCloseHour)
                                             || dt.day_of_week == 6 || dt.day_of_week == 0);
   if(g_standby == "" && friday) g_standby = "Friday close";
   bool flatten = g_standby != "" && StringFind(g_standby, "algo trading") < 0;   // cannot close if trading is off
   int dir; double vol, profit;
   if(flatten && TimeCurrent() - g_last_flatten >= 60 && OwnPositions(dir, vol, profit) > 0)
     {
      g_last_flatten = TimeCurrent();   // a closed market refuses the close: retry once a minute, not every tick
      CloseOwn(0, g_standby);
     }
  }

// v4 spread-regime gate (engine/research/costs/spread_regime.py): the multiple of the median spread of the last
// InpSpreadRegimeBars CLOSED bars, the median floored at 1 point; -1 = no gate (off, or under half a window of bars).
double RegimeCap()
  {
   if(InpSpreadRegimeMultiple <= 0.0 || InpSpreadRegimeBars <= 0) return -1.0;
   int s[];
   int got = CopySpread(_Symbol, _Period, 1, InpSpreadRegimeBars, s);
   if(got < (InpSpreadRegimeBars + 1) / 2) return -1.0;
   ArraySort(s);
   double med = (got % 2 == 1) ? (double)s[got / 2] : ((double)s[got / 2 - 1] + (double)s[got / 2]) / 2.0;
   return InpSpreadRegimeMultiple * MathMax(med, 1.0);
  }

// The intent of the newest closed bar, executed at the open of the bar now forming.
void Act(const Intent &x)
  {
   int dir; double vol, profit;
   int own = OwnPositions(dir, vol, profit);
   if(x.volume == 0.0)
     {
      // a close intent's dir is the signal's new direction, not the position's: close whatever is open
      if(own > 0) CloseOwn(0, x.reason);
      return;
     }
   string why = g_standby;
   long spread = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   MqlDateTime dt;
   TimeToStruct(iTime(_Symbol, _Period, 0), dt);
   if(why == "" && C_NO_TRADE[dt.hour]) why = StringFormat("no-trade hour %d of the cell", dt.hour);
   if(why == "" && InpMaxSpreadPoints > 0 && spread > InpMaxSpreadPoints)
      why = StringFormat("spread %I64d > %d points", spread, InpMaxSpreadPoints);
   double cap = RegimeCap();
   if(why == "" && cap > 0.0 && (double)spread > cap)
      why = StringFormat("spread %I64d > %.1f points (%.1f x the median of the last %d bars)", spread, cap,
                         InpSpreadRegimeMultiple, InpSpreadRegimeBars);
   if(why == "" && ArqvioPositions() >= InpMaxAccountPositions)
      why = StringFormat("%d ARQVIO positions open (cap %d)", ArqvioPositions(), InpMaxAccountPositions);
   string news = "";
   if(why == "" && NewsBlocked(news)) why = news;
   if(why != "")
     {
      g_last_refusal = why;
      g_last_refusal_time = TimeCurrent();
      Log("ENTRY_REFUSED", x.reason + ": " + why);
      return;
     }
   if(own > 0 && dir != x.dir) CloseOwn(dir, "reversal");
   if(own > 0 && dir == x.dir) { Log("ENTRY_SKIPPED", "already in that direction"); return; }
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK), bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double price = (x.dir > 0) ? ask : bid;
   double stops = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;
   if((x.has_sl && x.sl_dist < stops) || (x.has_tp && x.tp_dist < stops))
     { Log("ENTRY_REFUSED", StringFormat("%s: stop distance below the broker's %.5f", x.reason, stops)); return; }
   double sl = x.has_sl ? NormalizeDouble(price - x.dir * x.sl_dist, _Digits) : 0.0;
   double tp = x.has_tp ? NormalizeDouble(price + x.dir * x.tp_dist, _Digits) : 0.0;
   double lots = NormaliseLots(InpLots * InpLotScale);
   string comment = "ARQVIO " + DNA_HASH;
   bool ok = (x.dir > 0) ? trade.Buy(lots, _Symbol, 0.0, sl, tp, comment) : trade.Sell(lots, _Symbol, 0.0, sl, tp, comment);
   if(ok && (trade.ResultRetcode() == TRADE_RETCODE_DONE || trade.ResultRetcode() == TRADE_RETCODE_PLACED))
      Log("OPEN", StringFormat("%s %s %.2f lots sl %s tp %s (%s)", x.dir > 0 ? "BUY" : "SELL", _Symbol, lots,
                               DoubleToString(sl, _Digits), DoubleToString(tp, _Digits), x.reason));
   else
      Log("OPEN_FAILED", StringFormat("%s retcode %u %s", x.reason, trade.ResultRetcode(), trade.ResultRetcodeDescription()));
  }

void SwUpdate(const int i);   // the stateful bias switches (trailing, psar), defined with the other switches

void Ingest(const MqlRates &r)
  {
   int i = g_n;
   ArrayResize(g_time, i + 1, 65536); ArrayResize(g_open, i + 1, 65536); ArrayResize(g_high, i + 1, 65536);
   ArrayResize(g_low, i + 1, 65536); ArrayResize(g_close, i + 1, 65536); ArrayResize(g_vol, i + 1, 65536);
   g_time[i] = (long)r.time; g_open[i] = r.open; g_high[i] = r.high; g_low[i] = r.low; g_close[i] = r.close;
   g_vol[i] = (double)r.tick_volume;
   UpdateTR(i);
   SwUpdate(i);
   FamilyUpdate(i);
   if(TREND_EMA > 0)
     {
      g_ema = (g_ema_n == 0) ? r.close : g_ema + (2.0 / (TREND_EMA + 1.0)) * (r.close - g_ema);
      g_ema_n++;
     }
   g_n = i + 1;
   g_last_time = (long)r.time;
  }

// v4 bias / filter switches (engine/research/backtest/switch_gates.py): the same rules, read from the closed bars
// ingested so far; sums run oldest to newest as in the engine. None allows an opening before its full lookback.
double SwMean(const double &a[], const int i, const int n)
  {
   double s = 0.0;
   for(int k = i - n + 1; k <= i; k++) s += a[k];
   return s / n;
  }

// Stateful bias switches, advanced once per ingested bar (oldest first) as the engine steps them; SwitchOpen only
// ever asks about the newest bar, so the current state is all it reads.
int g_trl_dir = 0;
double g_trl_stop = 0.0;
int g_ps_n = 0;
bool g_ps_up = true;
double g_ps_sar = 0.0, g_ps_ep = 0.0, g_ps_af = 0.02, g_ps_h1 = 0.0, g_ps_l1 = 0.0, g_ps_h2 = 0.0, g_ps_l2 = 0.0, g_ps_c1 = 0.0;

void SwUpdate(const int i)
  {
{% if "trailing" in bias %}
   if(i >= 13)
     {
      double a = SwMean(g_tr, i, 14), c = g_close[i];
      if(g_trl_dir == 0) { g_trl_dir = 1; g_trl_stop = c - 3.0 * a; }
      else if(g_trl_dir > 0) { if(c < g_trl_stop) { g_trl_dir = -1; g_trl_stop = c + 3.0 * a; } else g_trl_stop = MathMax(g_trl_stop, c - 3.0 * a); }
      else if(c > g_trl_stop) { g_trl_dir = 1; g_trl_stop = c - 3.0 * a; }
      else g_trl_stop = MathMin(g_trl_stop, c + 3.0 * a);
     }
{% endif %}
{% if "psar" in bias %}
   {
    double h = g_high[i], l = g_low[i], c = g_close[i];
    if(g_ps_n == 1)
      {
       g_ps_up = c >= g_ps_c1;
       if(g_ps_up) { g_ps_sar = g_ps_l1; g_ps_ep = MathMax(g_ps_h1, h); }
       else { g_ps_sar = g_ps_h1; g_ps_ep = MathMin(g_ps_l1, l); }
      }
    else if(g_ps_n >= 2)
      {
       double sar = g_ps_sar + g_ps_af * (g_ps_ep - g_ps_sar);
       if(g_ps_up)
         {
          sar = MathMin(sar, MathMin(g_ps_l1, g_ps_l2));
          if(l < sar) { g_ps_up = false; sar = g_ps_ep; g_ps_ep = l; g_ps_af = 0.02; }
          else if(h > g_ps_ep) { g_ps_ep = h; g_ps_af = MathMin(g_ps_af + 0.02, 0.2); }
         }
       else
         {
          sar = MathMax(sar, MathMax(g_ps_h1, g_ps_h2));
          if(h > sar) { g_ps_up = true; sar = g_ps_ep; g_ps_ep = h; g_ps_af = 0.02; }
          else if(l < g_ps_ep) { g_ps_ep = l; g_ps_af = MathMin(g_ps_af + 0.02, 0.2); }
         }
       g_ps_sar = sar;
      }
    g_ps_h2 = g_ps_h1; g_ps_l2 = g_ps_l1; g_ps_h1 = h; g_ps_l1 = l; g_ps_c1 = c;
    g_ps_n++;
   }
{% endif %}
  }

// The day's VWAP up to bar i (switch_gates.BiasVwap): typical price x tick volume from the day's first bar on.
bool SwVwap(const int i, double &w)
  {
   long day = g_time[i] / 86400;
   int k = i;
   while(k > 0 && g_time[k - 1] / 86400 == day) k--;
   double pv = 0.0, vv = 0.0;
   for(int x = k; x <= i; x++) { pv += (g_high[x] + g_low[x] + g_close[x]) / 3.0 * g_vol[x]; vv += g_vol[x]; }
   if(!(vv > 0.0)) return false;
   w = pv / vv;
   return true;
  }

bool SwitchOpen(const int i, const int dir)
  {
{% if "sma" in bias %}
   if(i < 99) return false;
   { double m = SwMean(g_close, i, 100); if(dir > 0 ? !(g_close[i] > m) : !(g_close[i] < m)) return false; }
{% endif %}
