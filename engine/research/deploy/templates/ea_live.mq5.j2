//--- intents (the tester EA's shape; the partials build them) --------
struct Intent
  {
   int dir;          // +1 long, -1 short
   double volume;    // 0 = close
   bool has_sl;
   double sl_dist;
   bool has_tp;
   double tp_dist;
   int bar_index;
   long id;
   bool deferred;
   string reason;
  };

long g_intent_seq = 0;
int g_dir = 0;           // strategy_state["direction"]
int g_pending_dir = 0;   // strategy_state["pending_direction"]

bool StopDistances(const int i, const double sl_atr, const double tp_atr, const int atr_period,
                   bool &suppress, bool &has_sl, double &sl_dist, bool &has_tp, double &tp_dist)
  {
   bool want_sl = sl_atr > 0.0, want_tp = tp_atr > 0.0;
   suppress = false; has_sl = false; has_tp = false; sl_dist = 0.0; tp_dist = 0.0;
   if(!want_sl && !want_tp) return true;
   double atr = 0.0;
   if(!AtrAt(i, atr_period, atr)) { suppress = true; return true; }
   if(want_sl) { has_sl = true; sl_dist = sl_atr * atr; }
   if(want_tp) { has_tp = true; tp_dist = tp_atr * atr; }
   return true;
  }

Intent MakeIntent(const int dir, const double volume, const int i, const string reason,
                  const bool has_sl, const double sl_dist, const bool has_tp, const double tp_dist)
  {
   Intent x;
   x.dir = dir; x.volume = volume; x.bar_index = i; x.reason = reason;
   x.has_sl = has_sl; x.sl_dist = sl_dist; x.has_tp = has_tp; x.tp_dist = tp_dist;
   x.id = ++g_intent_seq; x.deferred = false;
   return x;
  }

