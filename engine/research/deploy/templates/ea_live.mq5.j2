   }
{% endif %}
{% if "rsi" in bias %}
   if(i < 14) return false;
   {
    double g = 0.0, l = 0.0;
    for(int k = i - 13; k <= i; k++) { double ch = g_close[k] - g_close[k - 1]; g += (ch > 0.0 ? ch : 0.0); l += (ch < 0.0 ? -ch : 0.0); }
    g /= 14.0; l /= 14.0;
